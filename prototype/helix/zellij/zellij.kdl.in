mouse_mode true
pane_frames true
copy_on_select false
scroll_buffer_size 10000
support_kitty_keyboard_protocol true

load_plugins {
    "file:__HOME__/.local/share/devtui/zellij-link-devtui-helix.wasm"
}

keybinds {
    shared {
        bind "F4" {
            SwitchToMode "Normal"
            MessagePlugin "file:__HOME__/.local/share/devtui/devtui-shortcuts.wasm" {
                name "toggle-shortcuts"
                title "devtui Keyboard Shortcuts (F4)"
                floating true
            }
        }
    }
    normal {
        unbind "Ctrl s" "Ctrl h" "Ctrl p" "Alt l" "Alt p"
        // Find in Selection / Preserve Case reach the editor; Alt+Right
        // remains available for workspace focus navigation.

        // Keep modified Enter distinct when forwarding the Replace All key.
        bind "Ctrl Alt Enter" { Write 27 91 49 51 59 55 117; }

        // Preserve Ctrl-Shift-Z as a distinct key through terminal/Zellij paths.
        bind "Ctrl Shift z" { Write 27 91 49 50 50 59 54 117; }
    }
}
