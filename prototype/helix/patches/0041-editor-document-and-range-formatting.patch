+    /// Capability checks must not start a formatting request while building a menu.
+    pub fn can_format(&self) -> bool {
+        self.language_config().and_then(|config| config.formatter.as_ref())
+            .is_some_and(|formatter| helix_stdx::env::which(&formatter.command).is_ok())
+            || self.language_servers_with_feature(LanguageServerFeature::Format).next().is_some()
+    }
+
+    /// Range formatting is a distinct LSP capability. A range-only provider is
+    /// valid even when it does not advertise whole-document formatting.
+    pub fn range_formatting_language_server(&self) -> Option<Arc<Client>> {
+        self.language_config()?.language_servers.iter().find_map(|features| {
+            let server = self.language_servers.get(&features.name)?;
+            (server.is_initialized() && features.has_feature(LanguageServerFeature::Format)
+                && matches!(server.capabilities().document_range_formatting_provider,
+                    Some(lsp::OneOf::Left(true) | lsp::OneOf::Right(_))))
+                .then(|| Arc::clone(server))
+        })
+    }
