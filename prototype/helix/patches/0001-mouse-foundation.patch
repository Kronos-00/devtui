+    fn update_middle_drag_selection(&mut self, editor: &mut Editor, row: u16) -> bool {
+        let Some((anchor_row, anchor_column)) = self.middle_drag_anchor else {
+            return false;
+        };
+
+        let first_row = anchor_row.min(row);
+        let last_row = anchor_row.max(row);
+        let (view, doc) = current!(editor);
+        let view_id = view.id;
+        let mut ranges: Vec<Range> = Vec::new();
+        let mut primary_index = 0;
+        let mut last_pos = None;
+
+        for screen_row in first_row..=last_row {
+            let Some(pos) = view.pos_at_screen_coords(doc, screen_row, anchor_column, true) else {
+                continue;
+            };
+            if last_pos == Some(pos) {
+                continue;
+            }
+            if screen_row == row {
+                primary_index = ranges.len();
+            }
+            ranges.push(Range::point(pos));
+            last_pos = Some(pos);
+        }
+
+        if ranges.is_empty() {
+            return false;
+        }
+        primary_index = primary_index.min(ranges.len() - 1);
+        doc.set_selection(
+            view_id,
+            Selection::new(ranges.into_iter().collect(), primary_index),
+        );
+        editor.ensure_cursor_in_view(view_id);
+        true
+    }
