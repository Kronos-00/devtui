+// VS Code's default word-separator classes. Underscores and non-ASCII
+// identifier characters stay in the same word; whitespace and punctuation form
+// their own runs. At a boundary, a touching regular word wins on the left.
+fn devtui_word_range(text: helix_core::RopeSlice<'_>, pos: usize) -> Range {
+    const SEPARATORS: &str = "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?";
+    let line = text.char_to_line(pos.min(text.len_chars()));
+    let start = text.line_to_char(line);
+    let end = helix_core::line_ending::line_end_char_index(&text, line);
+    let chars: Vec<char> = text.slice(start..end).chars().collect();
+    let offset = pos.saturating_sub(start).min(chars.len());
+    let class = |ch: char| if ch == ' ' || ch == '\t' { 0 } else if SEPARATORS.contains(ch) { 1 } else { 2 };
+    let pivot = if offset > 0 && class(chars[offset - 1]) == 2 { offset - 1 }
+        else if offset < chars.len() { offset }
+        else if offset > 0 && class(chars[offset - 1]) == 0 { offset - 1 }
+        else { return Range::point(pos.min(end)); };
+    let kind = class(chars[pivot]);
+    let mut left = pivot;
+    let mut right = pivot + 1;
+    while left > 0 && class(chars[left - 1]) == kind { left -= 1; }
+    while right < chars.len() && class(chars[right]) == kind { right += 1; }
+    Range::new(start + left, start + right)
+}
