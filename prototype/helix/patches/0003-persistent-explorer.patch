+    fn handle_explorer_key(&mut self, event: KeyEvent, editor: &mut Editor) -> bool {
+        let focus_explorer = event.modifiers.contains(KeyModifiers::CONTROL)
+            && match event.code {
+                KeyCode::Char('e') => event.modifiers.contains(KeyModifiers::SHIFT),
+                KeyCode::Char('E') => true,
+                _ => false,
+            };
+        if focus_explorer {
+            self.explorer.focused = true;
+            return true;
+        }
+
+        if !self.explorer.focused {
+            return false;
+        }
+
+        match event.code {
+            KeyCode::Esc => {}
+            KeyCode::Char('q') if event.modifiers.is_empty() => {}
+            KeyCode::Up => self.explorer.move_cursor(-1),
+            KeyCode::Down => self.explorer.move_cursor(1),
+            KeyCode::Home => self.explorer.cursor = 0,
+            KeyCode::End => {
+                self.explorer.cursor = self.explorer.rows.len().saturating_sub(1);
+            }
+            KeyCode::Right => self.explorer.expand_or_preview(editor),
+            KeyCode::Left => self.explorer.collapse_or_parent(),
+            KeyCode::Enter => self.explorer.activate_selected(editor, false),
+            KeyCode::Char('h') | KeyCode::Char('H')
+                if event.modifiers.contains(KeyModifiers::SHIFT) =>
+            {
+                self.explorer.show_hidden = !self.explorer.show_hidden;
+                self.explorer.rebuild();
+            }
+            KeyCode::Char('i') | KeyCode::Char('I')
+                if event.modifiers.contains(KeyModifiers::SHIFT) =>
+            {
+                self.explorer.show_ignored = !self.explorer.show_ignored;
+                self.explorer.rebuild();
+            }
+            _ => {}
+        }
+        true
+    }
+
+    fn handle_explorer_mouse(
+        &mut self,
+        event: &MouseEvent,
+        cxt: &mut commands::Context,
+    ) -> Option<EventResult> {
+        if self.layout_area.width == 0 {
+            return None;
+        }
+
+        let area = self.explorer.sidebar_area(self.layout_area);
+        let inside = event.column >= area.x
+            && event.column < area.right()
+            && event.row >= area.y
+            && event.row < area.bottom();
+
+        if self.explorer.dragging_resize {
+            match event.kind {
+                MouseEventKind::Drag(MouseButton::Left)
+                | MouseEventKind::Down(MouseButton::Left) => {
+                    let width = event.column.saturating_sub(self.layout_area.x) + 1;
+                    self.explorer.set_width(width, self.layout_area.width);
+                }
+                MouseEventKind::Up(MouseButton::Left) => {
+                    self.explorer.dragging_resize = false;
+                    self.explorer.save_width();
+                }
+                _ => {}
+            }
+            return Some(EventResult::Consumed(None));
+        }
+
+        if matches!(event.kind, MouseEventKind::Down(MouseButton::Left))
+            && self.explorer.resize_hot_zone(self.layout_area, event.column)
+        {
+            self.explorer.dragging_resize = true;
+            self.explorer.focused = true;
+            return Some(EventResult::Consumed(None));
+        }
+
+        if inside {
+            self.explorer.focused = true;
+            let visible_rows = area.height.saturating_sub(1) as usize;
+            match event.kind {
+                MouseEventKind::Down(MouseButton::Left) => {
+                    if let Some(index) = self.explorer.row_at(area, event.row) {
+                        self.explorer.click_row(index, cxt.editor);
+                    }
+                }
+                MouseEventKind::ScrollUp => self.explorer.scroll_by(-3, visible_rows),
+                MouseEventKind::ScrollDown => self.explorer.scroll_by(3, visible_rows),
+                _ => {}
+            }
+            return Some(EventResult::Consumed(None));
+        }
+
+        if matches!(event.kind, MouseEventKind::Down(MouseButton::Left)) {
+            self.explorer.focused = false;
+        }
+        None
+    }
