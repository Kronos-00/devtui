+// VS Code refuses to paste a folder into itself or a descendant. Resolve the
+// parent first so a symlinked destination cannot bypass that check.
+fn validate_copy_parent(source: &Path, directory: &Path) -> std::io::Result<()> {
+    let metadata = fs::symlink_metadata(source)?;
+    if metadata.is_dir() {
+        let source = fs::canonicalize(source)?;
+        let directory = fs::canonicalize(directory)?;
+        if directory.starts_with(&source) {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "Cannot paste a folder into itself or one of its descendants",
+            ));
+        }
+    }
+    Ok(())
+}
