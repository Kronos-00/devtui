+    fn handle_explorer_key(&mut self, event: KeyEvent, editor: &mut Editor) -> bool {
+        let focus_explorer = event.modifiers.contains(KeyModifiers::CONTROL)
+            && match event.code {
+                KeyCode::Char('e') => event.modifiers.contains(KeyModifiers::SHIFT),
+                KeyCode::Char('E') => true,
+                _ => false,
+            };
