+pub fn switch_source_header(cx: &mut Context) {
+    let (_, doc) = current_ref!(cx.editor);
+    let Some(language_server) = doc.language_servers().next() else {
+        cx.editor
+            .set_error("No language server is attached to the current document");
+        return;
+    };
+    let request = language_server.switch_source_header(doc.identifier());
+
+    cx.jobs.callback(async move {
+        let target = request.await?;
+        let call = move |editor: &mut Editor, _compositor: &mut Compositor| {
+            let Some(target) = target else {
+                editor.set_error("No paired source/header file found");
+                return;
+            };
+            let Ok(uri) = Uri::try_from(target) else {
+                editor.set_error("Language server returned an unsupported URI");
+                return;
+            };
+            let Some(path) = uri.as_path() else {
+                editor.set_error("Language server returned a non-file URI");
+                return;
+            };
+            if let Err(err) = editor.open(path, Action::Replace) {
+                editor.set_error(format!("failed to open paired file: {err}"));
+            }
+        };
+        Ok(Callback::EditorCompositor(Box::new(call)))
+    });
+}
