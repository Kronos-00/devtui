+fn devtui_line_selection_if_empty(editor: &Editor) -> Option<Selection> {
+    let (view, doc) = current_ref!(editor);
+    let current = doc.selection(view.id);
+    if current.ranges().iter().any(|range| !range.is_empty()) {
+        return None;
+    }
+
+    let text = doc.text().slice(..);
+    let mut ranges = SmallVec::with_capacity(current.len());
+    for range in current.ranges() {
+        let pos = range.cursor(text);
+        let line = doc.text().char_to_line(pos.min(doc.text().len_chars()));
+        let start = doc.text().line_to_char(line);
+        let end = doc
+            .text()
+            .line_to_char((line + 1).min(doc.text().len_lines()));
+        ranges.push(Range::new(start, end));
+    }
+    Some(Selection::new(ranges, current.primary_index()))
+}
+
+fn devtui_copy_to_clipboard(cx: &mut Context) {
+    let line_selection = devtui_line_selection_if_empty(cx.editor);
+    let original = if let Some(selection) = line_selection {
+        let (view, doc) = current!(cx.editor);
+        let original = doc.selection(view.id).clone();
+        doc.set_selection(view.id, selection);
+        Some(original)
+    } else {
+        None
+    };
+
+    yank_impl(cx.editor, '+');
+
+    if let Some(original) = original {
+        let (view, doc) = current!(cx.editor);
+        doc.set_selection(view.id, original);
+    }
+}
+
+fn devtui_cut_to_clipboard(cx: &mut Context) {
+    if let Some(selection) = devtui_line_selection_if_empty(cx.editor) {
+        let (view, doc) = current!(cx.editor);
+        doc.set_selection(view.id, selection);
+    }
+    yank_impl(cx.editor, '+');
+    delete_selection_impl(cx, Operation::Delete, YankAction::NoYank);
+}
