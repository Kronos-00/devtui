+fn next_copy_destination(directory: &Path, source: &Path) -> PathBuf {
+    let name = source
+        .file_name()
+        .and_then(|name| name.to_str())
+        .unwrap_or("copy");
+    let (stem, extension) = if source.is_file() {
+        match (source.file_stem().and_then(|s| s.to_str()), source.extension().and_then(|s| s.to_str())) {
+            (Some(stem), Some(ext)) => (stem.to_string(), Some(ext.to_string())),
+            _ => (name.to_string(), None),
+        }
+    } else {
+        (name.to_string(), None)
+    };
+
+    let split_copy = |value: &str| -> (String, Option<u32>) {
+        if let Some((base, suffix)) = value.rsplit_once(" copy") {
+            if suffix.is_empty() {
+                return (base.to_string(), Some(2));
+            }
+            if let Ok(number) = suffix.trim_start().parse::<u32>() {
+                return (base.to_string(), Some(number.saturating_add(1)));
+            }
+        }
+        (value.to_string(), None)
+    };
+
+    let (base, mut number) = split_copy(&stem);
+    loop {
+        let copied_stem = match number {
+            None => format!("{base} copy"),
+            Some(number) => format!("{base} copy {number}"),
+        };
+        let filename = extension
+            .as_ref()
+            .map(|ext| format!("{copied_stem}.{ext}"))
+            .unwrap_or(copied_stem);
+        let candidate = directory.join(filename);
+        if !candidate.exists() {
+            return candidate;
+        }
+        number = Some(number.unwrap_or(1).saturating_add(1));
+    }
+}
+
+fn copy_path_recursive(editor: &mut Editor, source: &Path, destination: &Path) -> std::io::Result<()> {
+    if source.is_dir() {
+        editor.create_path(destination, true)?;
+        for entry in fs::read_dir(source)? {
+            let entry = entry?;
+            let child_source = entry.path();
+            let child_destination = destination.join(entry.file_name());
+            copy_path_recursive(editor, &child_source, &child_destination)?;
+        }
+    } else {
+        editor.create_path(destination, false)?;
+        fs::copy(source, destination)?;
+    }
+    Ok(())
+}
+
+pub fn paste_explorer_clipboard(editor: &mut Editor, directory: &Path) {
+    let sources = distinct_paths(editor.devtui.explorer_clipboard.clone());
+    for source in sources {
+        let mut destination = directory.join(source.file_name().unwrap_or_default());
+        if destination.exists() || destination == source {
+            destination = next_copy_destination(directory, &source);
+        }
+        if let Err(err) = copy_path_recursive(editor, &source, &destination) {
+            editor.set_error(format!("Paste failed: {err}"));
+            break;
+        }
+    }
+}
+
+pub fn explorer_context_select(
+    root: PathBuf,
+    target: PathBuf,
+    is_dir: bool,
+    is_root: bool,
+    selection: Vec<PathBuf>,
+) -> Select<ExplorerAction> {
+    let mut actions = Vec::new();
+    if is_dir {
+        actions.extend([
+            ExplorerAction::NewFile,
+            ExplorerAction::NewFolder,
+            ExplorerAction::Paste,
+        ]);
+    }
+    if !is_root {
+        actions.push(ExplorerAction::Copy);
+    }
+    actions.extend([
+        ExplorerAction::CopyPath,
+        ExplorerAction::CopyRelativePath,
+    ]);
+    if !is_root && selection.len() == 1 {
+        actions.push(ExplorerAction::Rename);
+    }
+    if !is_root {
+        actions.push(ExplorerAction::Delete);
+    }
+
+    Select::new("Explorer", actions, (), move |editor, action, event| {
+        if event != PromptEvent::Validate {
+            return;
+        }
+        match action {
+            ExplorerAction::NewFile => {
+                editor.devtui.requests.push_back(DevTuiRequest::ExplorerCreate {
+                    directory: target.clone(),
+                    is_dir: false,
+                });
+            }
+            ExplorerAction::NewFolder => {
+                editor.devtui.requests.push_back(DevTuiRequest::ExplorerCreate {
+                    directory: target.clone(),
+                    is_dir: true,
+                });
+            }
+            ExplorerAction::Paste => paste_explorer_clipboard(editor, &target),
+            ExplorerAction::Copy => {
+                editor.devtui.explorer_clipboard = distinct_paths(selection.clone());
+            }
+            ExplorerAction::CopyPath => clipboard_paths(editor, &root, &selection, false),
+            ExplorerAction::CopyRelativePath => clipboard_paths(editor, &root, &selection, true),
+            ExplorerAction::Rename => {
+                editor.devtui.requests.push_back(DevTuiRequest::ExplorerRename {
+                    path: target.clone(),
+                });
+            }
+            ExplorerAction::Delete => {
+                let paths = distinct_paths(selection.clone())
+                    .into_iter()
+                    .filter(|path| path != &root)
+                    .collect();
+                editor
+                    .devtui
+                    .requests
+                    .push_back(DevTuiRequest::ExplorerDelete { paths });
+            }
+        }
+    })
+}
+
+pub fn explorer_create_prompt(directory: PathBuf, is_dir: bool) -> Prompt {
+    let label = if is_dir { "New Folder: " } else { "New File: " };
+    Prompt::new(
+        Cow::Owned(label.to_string()),
+        None,
+        ui::completers::none,
+        move |cx, input, event| {
+            if event != PromptEvent::Validate {
+                return;
+            }
+            let name = input.trim();
+            if name.is_empty() {
+                return;
+            }
+            let path = directory.join(name);
+            if let Err(err) = cx.editor.create_path(&path, is_dir) {
+                cx.editor.set_error(err.to_string());
+            }
+        },
+    )
+}
+
+pub fn explorer_rename_prompt(editor: &Editor, path: PathBuf) -> Prompt {
+    let current_name = path
+        .file_name()
+        .and_then(|name| name.to_str())
+        .unwrap_or_default()
+        .to_string();
+    Prompt::new(
+        Cow::Borrowed("Rename: "),
+        None,
+        ui::completers::none,
+        move |cx, input, event| {
+            if event != PromptEvent::Validate {
+                return;
+            }
+            let name = input.trim();
+            if name.is_empty() {
+                return;
+            }
+            let destination = path
+                .parent()
+                .map(|parent| parent.join(name))
+                .unwrap_or_else(|| PathBuf::from(name));
+            if let Err(err) = cx.editor.move_path(&path, &destination) {
+                cx.editor.set_error(err.to_string());
+            }
+        },
+    )
+    .with_line(current_name, editor)
+}
+
+pub fn explorer_delete_select(paths: Vec<PathBuf>) -> Select<DeleteChoice> {
+    let count = paths.len();
+    let title = if count == 1 {
+        format!(
+            "Delete {}?",
+            paths[0]
+                .file_name()
+                .and_then(|name| name.to_str())
+                .unwrap_or("item")
+        )
+    } else {
+        format!("Delete {count} selected items?")
+    };
+
+    Select::new(
+        title,
+        [DeleteChoice::Delete, DeleteChoice::Cancel],
+        (),
+        move |editor, choice, event| {
+            if event != PromptEvent::Validate || !matches!(choice, DeleteChoice::Delete) {
+                return;
+            }
+            for path in &paths {
+                if let Err(err) = editor.delete_path(path, true) {
+                    editor.set_error(err.to_string());
+                    break;
+                }
+            }
+        },
+    )
+}
+
+#[derive(Clone, Debug)]
+pub struct ExplorerRow {
+    pub path: PathBuf,
+    pub depth: usize,
+    pub is_dir: bool,
+}
+
+pub struct DevTuiExplorer {
+    pub root: PathBuf,
+    pub expanded: HashSet<PathBuf>,
+    pub rows: Vec<ExplorerRow>,
+    pub cursor: usize,
+    pub selected_paths: HashSet<PathBuf>,
+    pub scroll_offset: usize,
+    pub focused: bool,
+    pub width: u16,
+    pub dragging_resize: bool,
+    pub show_hidden: bool,
+    pub show_ignored: bool,
+    selection_anchor: Option<usize>,
+    last_click: Option<(Instant, usize)>,
+}
+
+impl Default for DevTuiExplorer {
+    fn default() -> Self {
+        let root = std::env::current_dir()
+            .ok()
+            .map(|path| helix_stdx::path::normalize(path))
+            .unwrap_or_else(|| PathBuf::from("."));
+        let mut expanded = HashSet::new();
+        expanded.insert(root.clone());
+        let mut this = Self {
+            root: root.clone(),
+            expanded,
+            rows: Vec::new(),
+            cursor: 0,
+            selected_paths: HashSet::from([root]),
+            scroll_offset: 0,
+            focused: true,
+            width: Self::load_width().unwrap_or(32),
+            dragging_resize: false,
+            show_hidden: true,
+            show_ignored: true,
+            selection_anchor: None,
+            last_click: None,
+        };
+        this.rebuild();
+        this
+    }
+}
+impl DevTuiExplorer {
+    const MIN_WIDTH: u16 = 12;
+
+    fn state_file() -> Option<PathBuf> {
+        if let Some(base) = std::env::var_os("XDG_STATE_HOME") {
+            return Some(PathBuf::from(base).join("devtui/explorer-width"));
+        }
+        std::env::var_os("HOME")
+            .map(PathBuf::from)
+            .map(|home| home.join(".local/state/devtui/explorer-width"))
+    }
+
+    fn load_width() -> Option<u16> {
+        let text = fs::read_to_string(Self::state_file()?).ok()?;
+        text.trim().parse().ok()
+    }
+
+    pub fn save_width(&self) {
+        let Some(path) = Self::state_file() else {
+            return;
+        };
+        if let Some(parent) = path.parent() {
+            let _ = fs::create_dir_all(parent);
+        }
+        let _ = fs::write(path, format!("{}\n", self.width));
+    }
+
+    pub fn set_width(&mut self, width: u16, total_width: u16) {
+        let max_width = total_width.saturating_sub(20).max(Self::MIN_WIDTH);
+        self.width = width.clamp(Self::MIN_WIDTH, max_width);
+    }
+
+    pub fn sidebar_area(&self, area: Rect) -> Rect {
+        let width = self
+            .width
+            .min(area.width.saturating_sub(20).max(Self::MIN_WIDTH));
+        Rect::new(area.x, area.y, width, area.height.saturating_sub(1))
+    }
+
+    pub fn editor_area(&self, area: Rect) -> Rect {
+        let sidebar = self.sidebar_area(area);
+        let x = sidebar.right().saturating_add(1);
+        Rect::new(
+            x,
+            area.y,
+            area.right().saturating_sub(x),
+            area.height,
+        )
+    }
+
+    pub fn resize_hot_zone(&self, area: Rect, column: u16) -> bool {
+        let sidebar = self.sidebar_area(area);
+        let right = sidebar.right();
+        column >= right.saturating_sub(3) && column <= right
+    }
+    fn child_rows(&self, dir: &Path) -> Vec<(PathBuf, bool)> {
+        let mut builder = WalkBuilder::new(dir);
+        builder
+            .max_depth(Some(1))
+            .hidden(!self.show_hidden)
+            .parents(!self.show_ignored)
+            .ignore(!self.show_ignored)
+            .git_ignore(!self.show_ignored)
+            .git_global(!self.show_ignored)
+            .git_exclude(!self.show_ignored)
+            .follow_links(false);
+
+        let mut children: Vec<_> = builder
+            .build()
+            .filter_map(Result::ok)
+            .filter_map(|entry| {
+                let path = entry.path().to_path_buf();
+                (path != dir).then(|| {
+                    let is_dir = path.is_dir();
+                    (path, is_dir)
+                })
+            })
+            .collect();
+
+        children.sort_by(|(a, ad), (b, bd)| {
+            (!*ad, a.file_name()).cmp(&(!*bd, b.file_name()))
+        });
+        children
+    }
+
+    fn push_children(&self, dir: &Path, depth: usize, out: &mut Vec<ExplorerRow>) {
+        for (path, is_dir) in self.child_rows(dir) {
+            out.push(ExplorerRow {
+                path: path.clone(),
+                depth,
+                is_dir,
+            });
+            if is_dir && self.expanded.contains(&path) {
+                self.push_children(&path, depth + 1, out);
+            }
+        }
+    }
+
+    pub fn rebuild(&mut self) {
+        let selected = self.rows.get(self.cursor).map(|row| row.path.clone());
+        let mut rows = vec![ExplorerRow {
+            path: self.root.clone(),
+            depth: 0,
+            is_dir: true,
+        }];
+        if self.expanded.contains(&self.root) {
+            self.push_children(&self.root, 1, &mut rows);
+        }
+        self.rows = rows;
+        self.cursor = selected
+            .and_then(|path| self.rows.iter().position(|row| row.path == path))
+            .unwrap_or_else(|| self.cursor.min(self.rows.len().saturating_sub(1)));
+
+        let visible: HashSet<_> = self.rows.iter().map(|row| row.path.clone()).collect();
+        self.selected_paths.retain(|path| visible.contains(path));
+        if self.selected_paths.is_empty() {
+            if let Some(row) = self.rows.get(self.cursor) {
+                self.selected_paths.insert(row.path.clone());
+            }
+        }
+    }
+
+    pub fn selected(&self) -> Option<&ExplorerRow> {
+        self.rows.get(self.cursor)
+    }
+
+    pub fn select_single(&mut self, index: usize) {
+        if let Some(row) = self.rows.get(index) {
+            self.cursor = index;
+            self.selection_anchor = Some(index);
+            self.selected_paths.clear();
+            self.selected_paths.insert(row.path.clone());
+        }
+    }
+
+    pub fn select_range(&mut self, index: usize) {
+        if self.rows.is_empty() || index >= self.rows.len() {
+            return;
+        }
+        let anchor = self
+            .selection_anchor
+            .unwrap_or(self.cursor)
+            .min(self.rows.len() - 1);
+        let (start, end) = (anchor.min(index), anchor.max(index));
+        self.cursor = index;
+        self.selected_paths.clear();
+        self.selected_paths.extend(
+            self.rows[start..=end]
+                .iter()
+                .map(|row| row.path.clone()),
+        );
+        self.last_click = None;
+    }
+
+    pub fn toggle_selection(&mut self, index: usize) {
+        let Some(row) = self.rows.get(index) else {
+            return;
+        };
+        self.cursor = index;
+        self.selection_anchor = Some(index);
+        self.last_click = None;
+        if !self.selected_paths.remove(&row.path) {
+            self.selected_paths.insert(row.path.clone());
+        }
+    }
+
+    pub fn is_selected_path(&self, path: &Path) -> bool {
+        self.selected_paths.contains(path)
+    }
+
+    pub fn selected_targets(&self) -> Vec<PathBuf> {
+        let mut targets: Vec<_> = self
+            .rows
+            .iter()
+            .filter(|row| self.selected_paths.contains(&row.path))
+            .map(|row| row.path.clone())
+            .collect();
+        if targets.is_empty() {
+            if let Some(row) = self.selected() {
+                targets.push(row.path.clone());
+            }
+        }
+        targets
+    }
+
+    pub fn distinct_selected_targets(&self) -> Vec<PathBuf> {
+        let mut targets = self.selected_targets();
+        targets.sort_by_key(|path| path.components().count());
+
+        let mut distinct = Vec::new();
+        for path in targets {
+            if distinct.iter().any(|parent: &PathBuf| path.starts_with(parent)) {
+                continue;
+            }
+            distinct.push(path);
+        }
+        distinct
+    }
+
+    pub fn context_target(&mut self, index: usize) -> Option<(ExplorerRow, Vec<PathBuf>)> {
+        let row = self.rows.get(index)?.clone();
+        self.cursor = index;
+        self.last_click = None;
+        if !self.selected_paths.contains(&row.path) {
+            self.selected_paths.clear();
+            self.selected_paths.insert(row.path.clone());
+        }
+        Some((row, self.selected_targets()))
+    }
+
+    pub fn move_cursor(&mut self, delta: isize) {
+        if self.rows.is_empty() {
+            self.cursor = 0;
+            return;
+        }
+        self.cursor = self
+            .cursor
+            .saturating_add_signed(delta)
+            .min(self.rows.len() - 1);
+        if let Some(row) = self.rows.get(self.cursor) {
+            self.selected_paths.clear();
+            self.selected_paths.insert(row.path.clone());
+        }
+    }
+    pub fn toggle_selected_dir(&mut self) {
+        let Some(row) = self.selected().cloned() else {
+            return;
+        };
+        if !row.is_dir {
+            return;
+        }
+        if !self.expanded.remove(&row.path) {
+            self.expanded.insert(row.path);
+        }
+        self.rebuild();
+    }
+
+    pub fn collapse_or_parent(&mut self) {
+        let Some(row) = self.selected().cloned() else {
+            return;
+        };
+        if row.is_dir && self.expanded.remove(&row.path) {
+            self.rebuild();
+            return;
+        }
+        if let Some(parent) = row.path.parent() {
+            if let Some(index) = self.rows.iter().position(|candidate| candidate.path == parent) {
+                self.cursor = index;
+            }
+        }
+    }
+
+    pub fn expand_or_preview(&mut self, editor: &mut Editor) {
+        let Some(row) = self.selected().cloned() else {
+            return;
+        };
+        if row.is_dir {
+            self.expanded.insert(row.path);
+            self.rebuild();
+        } else if let Err(err) = editor.devtui_open_preview(&row.path) {
+            editor.set_error(err.to_string());
+        }
+    }
+
+    pub fn activate_selected(&mut self, editor: &mut Editor, double_click: bool) {
+        let Some(row) = self.selected().cloned() else {
+            return;
+        };
+        if row.is_dir {
+            if double_click {
+                return;
+            }
+            self.toggle_selected_dir();
+        } else if double_click {
+            if let Err(err) = editor.devtui_open_pinned(&row.path) {
+                editor.set_error(err.to_string());
+            }
+        } else if let Err(err) = editor.devtui_open_preview(&row.path) {
+            editor.set_error(err.to_string());
+        }
+    }
+
+    pub fn click_row(&mut self, index: usize, editor: &mut Editor) {
+        if index >= self.rows.len() {
+            return;
+        }
+        self.select_single(index);
+        let now = Instant::now();
+        let double_click = self.last_click.is_some_and(|(at, previous)| {
+            previous == index && now.duration_since(at) <= Duration::from_millis(450)
+        });
+        self.last_click = Some((now, index));
+        self.activate_selected(editor, double_click);
+    }
+    pub fn row_at(&self, area: Rect, row: u16) -> Option<usize> {
+        if row <= area.y || row >= area.bottom() {
+            return None;
+        }
+        let index = self.scroll_offset + (row - area.y - 1) as usize;
+        (index < self.rows.len()).then_some(index)
+    }
+
+    pub fn scroll_by(&mut self, delta: isize, visible_rows: usize) {
+        let max = self.rows.len().saturating_sub(visible_rows.max(1));
+        self.scroll_offset = self.scroll_offset.saturating_add_signed(delta).min(max);
+    }
+
+    pub fn ensure_cursor_visible(&mut self, visible_rows: usize) {
+        let visible_rows = visible_rows.max(1);
+        if self.cursor < self.scroll_offset {
+            self.scroll_offset = self.cursor;
+        } else if self.cursor >= self.scroll_offset + visible_rows {
+            self.scroll_offset = self.cursor + 1 - visible_rows;
+        }
+    }
+
+    pub fn render(&mut self, area: Rect, surface: &mut Surface, editor: &Editor) {
+        self.rebuild();
+        let bg = editor.theme.get("ui.background");
+        let text = editor.theme.get("ui.text");
+        let directory = editor.theme.get("ui.text.directory");
+        let selected = editor.theme.get("ui.text.focus");
+        let title = if self.focused {
+            editor.theme.get("ui.statusline.active")
+        } else {
+            editor.theme.get("ui.statusline")
+        };
+
+        surface.clear_with(area, bg);
+        let root_name = self
+            .root
+            .file_name()
+            .and_then(|name| name.to_str())
+            .filter(|name| !name.is_empty())
+            .unwrap_or("workspace")
+            .to_string();
+        surface.set_stringn(
+            area.x,
+            area.y,
+            &format!(" EXPLORER · {root_name}"),
+            area.width as usize,
+            title.add_modifier(Modifier::BOLD),
+        );
+
+        let visible = area.height.saturating_sub(1) as usize;
+        self.ensure_cursor_visible(visible);
+        let scroll = self.scroll_offset;
+        for (screen_index, row) in self
+            .rows
+            .iter()
+            .skip(scroll)
+            .take(visible)
+            .enumerate()
+        {
+            let y = area.y + 1 + screen_index as u16;
+            let indent = "  ".repeat(row.depth);
+            let marker = if row.is_dir {
+                if self.expanded.contains(&row.path) { "▾ " } else { "▸ " }
+            } else {
+                "  "
+            };
+            let name = if row.depth == 0 {
+                root_name.to_string()
+            } else {
+                row.path
+                    .file_name()
+                    .and_then(|name| name.to_str())
+                    .unwrap_or("?")
+                    .to_string()
+            };
+            let style = if self.selected_paths.contains(&row.path) {
+                selected
+            } else if row.is_dir {
+                directory
+            } else {
+                text
+            };
+            surface.set_stringn(
+                area.x,
+                y,
+                &format!("{indent}{marker}{name}"),
+                area.width as usize,
+                style,
+            );
+        }
+    }
+}
