+        if !self.explorer.focused {
+            return false;
+        }
+
+        if event.modifiers.contains(KeyModifiers::CONTROL) {
+            match event.code {
+                KeyCode::Char('c') | KeyCode::Char('C') => {
+                    self.explorer.rebuild();
+                    let paths = self
+                        .explorer
+                        .distinct_selected_targets()
+                        .into_iter()
+                        .filter(|path| path != &self.explorer.root)
+                        .collect();
+                    editor.devtui.explorer_clipboard = paths;
+                    return true;
+                }
+                KeyCode::Char('v') | KeyCode::Char('V') => {
+                    self.explorer.rebuild();
+                    if let Some(row) = self.explorer.selected().cloned() {
+                        let directory = if row.is_dir {
+                            row.path
+                        } else {
+                            row.path
+                                .parent()
+                                .map(PathBuf::from)
+                                .unwrap_or_else(|| self.explorer.root.clone())
+                        };
+                        crate::ui::devtui::paste_explorer_clipboard(editor, &directory);
+                    }
+                    return true;
+                }
+                _ => {}
+            }
+        }
+
+        if matches!(event.code, KeyCode::Delete) {
+            let paths = self
+                .explorer
+                .distinct_selected_targets()
+                .into_iter()
+                .filter(|path| path != &self.explorer.root)
+                .collect();
+            editor
+                .devtui
+                .requests
+                .push_back(helix_view::editor::DevTuiRequest::ExplorerDelete { paths });
+            return true;
+        }
+
+        match event.code {
+            KeyCode::Esc => {}
+            KeyCode::Char('q') if event.modifiers.is_empty() => {}
+            KeyCode::Up => self.explorer.move_cursor(-1),
+            KeyCode::Down => self.explorer.move_cursor(1),
+            KeyCode::Home => self.explorer.select_single(0),
+            KeyCode::End => {
+                let index = self.explorer.rows.len().saturating_sub(1);
+                self.explorer.select_single(index);
+            }
+            KeyCode::Right => self.explorer.expand_or_preview(editor),
+            KeyCode::Left => self.explorer.collapse_or_parent(),
+            KeyCode::Enter => self.explorer.activate_selected(editor, false),
+            KeyCode::Char('h') | KeyCode::Char('H')
+                if event.modifiers.contains(KeyModifiers::SHIFT) =>
