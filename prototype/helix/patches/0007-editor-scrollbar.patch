+    fn scrollbar_geometry(editor: &Editor, view_id: ViewId) -> Option<DevTuiScrollbarGeometry> {
+        let view = editor.tree.try_get(view_id)?;
+        let doc = editor.document(view.doc)?;
+        let inner = view.inner_area(doc);
+        if inner.height < 3 || inner.width < 2 {
+            return None;
+        }
+
+        let total_lines = doc.text().len_lines().max(1);
+        let visible_lines = inner.height as usize;
+        if total_lines <= visible_lines {
+            return None;
+        }
+
+        let max_top_line = total_lines.saturating_sub(visible_lines);
+        let top_line = doc
+            .text()
+            .char_to_line(doc.view_offset(view_id).anchor.min(doc.text().len_chars()))
+            .min(max_top_line);
+
+        let track_height = inner.height;
+        let thumb_height = ((visible_lines * track_height as usize) / total_lines)
+            .clamp(1, track_height as usize) as u16;
+        let track_span = track_height.saturating_sub(thumb_height);
+        let thumb_offset = if max_top_line == 0 || track_span == 0 {
+            0
+        } else {
+            ((top_line * track_span as usize) / max_top_line) as u16
+        };
+
+        Some(DevTuiScrollbarGeometry {
+            view_id,
+            x: inner.right().saturating_sub(1),
+            track_top: inner.y,
+            track_height,
+            thumb_top: inner.y.saturating_add(thumb_offset),
+            thumb_height,
+            max_top_line,
+        })
+    }
+
+    fn scrollbar_at(editor: &Editor, row: u16, column: u16) -> Option<DevTuiScrollbarGeometry> {
+        editor.tree.views().find_map(|(view, _)| {
+            let geometry = Self::scrollbar_geometry(editor, view.id)?;
+            (column == geometry.x
+                && row >= geometry.track_top
+                && row < geometry.track_top.saturating_add(geometry.track_height))
+                .then_some(geometry)
+        })
+    }
+
+    fn scroll_from_drag(editor: &mut Editor, drag: DevTuiScrollbarDrag, row: u16) -> bool {
+        let track_span = drag.track_height.saturating_sub(drag.thumb_height);
+        let thumb_top = row
+            .saturating_sub(drag.grab_offset)
+            .saturating_sub(drag.track_top)
+            .min(track_span);
+        let top_line = if track_span == 0 || drag.max_top_line == 0 {
+            0
+        } else {
+            ((thumb_top as usize * drag.max_top_line) + track_span as usize / 2)
+                / track_span as usize
+        };
+
+        let Some(view) = editor.tree.try_get(drag.view_id).cloned() else {
+            return false;
+        };
+        let Some(doc) = editor.document_mut(view.doc) else {
+            return false;
+        };
+        let target_line = top_line.min(doc.text().len_lines().saturating_sub(1));
+        let mut offset = doc.view_offset(drag.view_id);
+        offset.anchor = doc.text().line_to_char(target_line);
+        offset.vertical_offset = 0;
+        doc.set_view_offset(drag.view_id, offset);
+        editor.needs_redraw = true;
+        true
+    }
+
+    fn render_scrollbar(editor: &Editor, doc: &Document, view: &View, surface: &mut Surface) {
+        let Some(geometry) = Self::scrollbar_geometry(editor, view.id) else {
+            return;
