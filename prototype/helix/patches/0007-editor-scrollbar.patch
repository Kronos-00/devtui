+            .try_get("ui.menu.scroll")
+            .unwrap_or_else(|| editor.theme.get("ui.text.focus"));
+
+        for y in geometry.track_top..geometry.track_top.saturating_add(geometry.track_height) {
+            if let Some(cell) = surface.get_mut(geometry.x, y) {
+                cell.set_symbol("│").set_style(track_style);
+            }
+        }
+        for y in geometry.thumb_top..geometry.thumb_top.saturating_add(geometry.thumb_height) {
+            if let Some(cell) = surface.get_mut(geometry.x, y) {
+                cell.set_symbol("█").set_style(thumb_style);
+            }
+        }
+
+        let _ = doc;
+    }
