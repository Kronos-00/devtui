-        Mode::Normal => Paste::Before,
-    };
     let (view, doc) = current!(cx.editor);
-
-    // VS Code's default editor.multiCursorPaste="spread": when pasted rows
-    // match the number of selections, distribute one row to each selection in
-    // document order. Otherwise every selection receives the full pasted block.
-    let selection_count = doc.selection(view.id).len();
-    if let Some(spread_values) = devtui_spread_paste_values(&contents, selection_count) {
-        paste_impl(
-            &spread_values,
-            doc,
-            view,
-            paste,
-            count,
-            cx.editor.mode,
-        );
-    } else {
-        paste_impl(&[contents], doc, view, paste, count, cx.editor.mode);
-    }
+    doc.append_changes_to_history(view);
+    let selection = doc.selection(view.id).clone();
+    let values = devtui_spread_paste_values(&contents, selection.len());
+    let text = doc.text().slice(..);
+    let mut changes = Vec::with_capacity(selection.len());
+    let mut carets = SmallVec::with_capacity(selection.len());
+    let mut offset: isize = 0;
+    for (index, range) in selection.ranges().iter().enumerate() {
+        let (start, end) = if explicit {
+            (range.from(), range.to())
+        } else {
+            let cursor = range.cursor(text);
+            (cursor, cursor)
+        };
+        let value = values.as_ref().map(|rows| rows[index].as_str()).unwrap_or(&contents);
+        let value = LINE_ENDING_REGEX.replace_all(value, doc.line_ending.as_str()).repeat(count);
+        let length = value.chars().count();
+        let cursor = start.saturating_add_signed(offset) + length;
+        carets.push(Range::point(cursor));
+        offset += length as isize - (end - start) as isize;
+        changes.push((start, end, Some(Tendril::from(value))));
