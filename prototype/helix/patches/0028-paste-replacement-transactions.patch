 pub(crate) fn paste_bracketed_value(cx: &mut Context, contents: String) {
+    // Match VS Code PasteOperation: replace the selected ranges in one undo
+    // transaction, distribute rows only when counts match, and leave carets
+    // after the inserted text. Terminal paste has no linewise metadata.
+    let explicit = cx.editor.devtui.explicit_selection
+        || cx.editor.devtui.column_selection_active
+        || cx.editor.mode == Mode::Select;
     let count = cx.count();
