diff --git a/helix-term/src/ui/devtui.rs b/helix-term/src/ui/devtui.rs
new file mode 100644
index 0000000..c78c046
--- /dev/null
+++ b/helix-term/src/ui/devtui.rs
@@ -0,0 +1,102 @@
+use std::{borrow::Cow, path::PathBuf};
+
+use helix_view::{editor::DevTuiRequest, DocumentId, Editor};
+use tui::widgets::Row;
+
+use crate::ui::{self, menu::Item, Prompt, PromptEvent, Select};
+
+#[derive(Clone, Copy, Debug, Default)]
+pub enum CloseChoice {
+    #[default]
+    Save,
+    DontSave,
+    Cancel,
+}
+
+impl Item for CloseChoice {
+    type Data = ();
+
+    fn format(&self, _data: &Self::Data) -> Row<'_> {
+        match self {
+            Self::Save => "Save",
+            Self::DontSave => "Don't Save",
+            Self::Cancel => "Cancel",
+        }
+        .into()
+    }
+}
+pub fn close_select(doc_id: DocumentId, display_name: String) -> Select<CloseChoice> {
+    Select::new(
+        format!("Save changes to {display_name}?"),
+        [CloseChoice::Save, CloseChoice::DontSave, CloseChoice::Cancel],
+        (),
+        move |editor, choice, event| {
+            if event != PromptEvent::Validate {
+                return;
+            }
+
+            match choice {
+                CloseChoice::Save => {
+                    let untitled = editor
+                        .document(doc_id)
+                        .is_some_and(|doc| doc.path().is_none());
+                    if untitled {
+                        editor.devtui.requests.push_back(DevTuiRequest::SaveAs {
+                            doc_id,
+                            close_after_save: true,
+                        });
+                    } else {
+                        editor.devtui.close_after_save.insert(doc_id);
+                        if let Err(err) = editor.save(doc_id, None::<PathBuf>, false) {
+                            editor.devtui.close_after_save.remove(&doc_id);
+                            editor.set_error(err.to_string());
+                        }
+                    }
+                }
+                CloseChoice::DontSave => {
+                    let _ = editor.close_document(doc_id, true);
+                }
+                CloseChoice::Cancel => {}
+            }
+        },
+    )
+}
+pub fn save_as_prompt(
+    editor: &Editor,
+    doc_id: DocumentId,
+    close_after_save: bool,
+) -> Prompt {
+    let default_path = std::env::current_dir()
+        .ok()
+        .map(|path| {
+            let mut text = path.to_string_lossy().into_owned();
+            if !text.ends_with(std::path::MAIN_SEPARATOR) {
+                text.push(std::path::MAIN_SEPARATOR);
+            }
+            text
+        })
+        .unwrap_or_default();
+
+    Prompt::new(
+        Cow::Borrowed("Save As: "),
+        None,
+        ui::completers::filename,
+        move |cx, input, event| {
+            if event != PromptEvent::Validate || input.trim().is_empty() {
+                return;
+            }
+
+            if close_after_save {
+                cx.editor.devtui.close_after_save.insert(doc_id);
+            }
+            if let Err(err) = cx
+                .editor
+                .save(doc_id, Some(PathBuf::from(input)), false)
+            {
+                cx.editor.devtui.close_after_save.remove(&doc_id);
+                cx.editor.set_error(err.to_string());
+            }
+        },
+    )
+    .with_line(default_path, editor)
+}
