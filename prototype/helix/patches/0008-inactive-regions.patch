diff --git a/helix-term/src/application.rs b/helix-term/src/application.rs
index f2ec2bd..7fad84f 100644
--- a/helix-term/src/application.rs
+++ b/helix-term/src/application.rs
@@ -1115,6 +1115,46 @@ macro_rules! language_server {
                             params.diagnostics,
                         );
                     }
+                    Notification::InactiveRegions(params) => {
+                        let language_server = language_server!();
+                        if !language_server.is_initialized() {
+                            return;
+                        }
+                        let offset_encoding = language_server.offset_encoding();
+                        let uri = match helix_core::Uri::try_from(params.text_document.uri) {
+                            Ok(uri) => uri,
+                            Err(err) => {
+                                log::error!("{err}");
+                                return;
+                            }
+                        };
+                        let Some(path) = uri.as_path() else {
+                            return;
+                        };
+                        let Some(doc_id) = self.editor.document_id_by_path(path) else {
+                            return;
+                        };
+                        let doc = doc_mut!(self.editor, &doc_id);
+                        let ranges = params
+                            .regions
+                            .into_iter()
+                            .filter_map(|range| {
+                                lsp_range_to_range(doc.text(), range, offset_encoding)
+                            })
+                            .map(|range| {
+                                let start = range.from();
+                                let end = range.to();
+                                start.min(end)..start.max(end)
+                            })
+                            .collect();
+                        doc.inactive_regions = ranges;
+                        log::debug!(
+                            "updated {} inactive source region(s) for {}",
+                            doc.inactive_regions.len(),
+                            path.display()
+                        );
+                        self.editor.needs_redraw = true;
+                    }
                     Notification::ShowMessage(params) => {
                         self.handle_show_message(params.typ, params.message);
                     }
