+fn devtui_goto_line_prompt(cx: &mut Context) {
+    ui::prompt(
+        cx,
+        "Go to Line: ".into(),
+        None,
+        ui::completers::none,
+        |cx, input, event| {
+            if event != PromptEvent::Validate {
+                return;
+            }
+            let Ok(line) = input.trim().parse::<usize>() else {
+                cx.editor.set_error("Line number must be a positive integer");
+                return;
+            };
+            let Some(line) = NonZeroUsize::new(line) else {
+                cx.editor.set_error("Line number must be greater than zero");
+                return;
+            };
+
+            {
+                let (view, doc) = current!(cx.editor);
+                push_jump(view, doc);
+            }
+            goto_line_without_jumplist(cx.editor, Some(line), Movement::Move);
+        },
+    );
+}
