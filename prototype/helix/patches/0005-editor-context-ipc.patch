+#[derive(Clone, Copy, Debug)]
+pub enum SymbolContextAction {
+    GoToDefinition,
+    GoToDeclaration,
+    GoToReferences,
+    GoToTypeDefinition,
+    GoToImplementation,
+    Hover,
+    Rename,
+    CodeAction,
+}
+
+impl Item for SymbolContextAction {
+    type Data = ();
+
+    fn format(&self, _data: &Self::Data) -> Row<'_> {
+        match self {
+            Self::GoToDefinition => "Go to Definition",
+            Self::GoToDeclaration => "Go to Declaration",
+            Self::GoToReferences => "Go to References",
+            Self::GoToTypeDefinition => "Go to Type Definition",
+            Self::GoToImplementation => "Go to Implementation",
+            Self::Hover => "Show Hover",
+            Self::Rename => "Rename Symbol",
+            Self::CodeAction => "Code Action",
+        }
+        .into()
+    }
+}
+
+impl SymbolContextAction {
+    fn command(self) -> &'static str {
+        match self {
+            Self::GoToDefinition => "goto_definition",
+            Self::GoToDeclaration => "goto_declaration",
+            Self::GoToReferences => "goto_reference",
+            Self::GoToTypeDefinition => "goto_type_definition",
+            Self::GoToImplementation => "goto_implementation",
+            Self::Hover => "hover",
+            Self::Rename => "rename_symbol",
+            Self::CodeAction => "code_action",
+        }
+    }
+}
+
+pub fn symbol_context_select() -> Select<SymbolContextAction> {
+    Select::new(
+        "Editor",
+        [
+            SymbolContextAction::GoToDefinition,
+            SymbolContextAction::GoToDeclaration,
+            SymbolContextAction::GoToReferences,
+            SymbolContextAction::GoToTypeDefinition,
+            SymbolContextAction::GoToImplementation,
+            SymbolContextAction::Hover,
+            SymbolContextAction::Rename,
+            SymbolContextAction::CodeAction,
+        ],
+        (),
+        |editor, action, event| {
+            if event == PromptEvent::Validate {
+                editor
+                    .devtui
+                    .requests
+                    .push_back(DevTuiRequest::SymbolAction(action.command()));
+            }
+        },
+    )
+}
