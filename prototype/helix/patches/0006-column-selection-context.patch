+#[derive(Clone, Copy, Debug)]
+pub enum SelectionContextAction {
+    Copy,
+    Cut,
+    Delete,
+}
+
+impl Item for SelectionContextAction {
+    type Data = ();
+
+    fn format(&self, _data: &Self::Data) -> Row<'_> {
+        match self {
+            Self::Copy => "Copy",
+            Self::Cut => "Cut",
+            Self::Delete => "Delete",
+        }
+        .into()
+    }
+}
+
+impl SelectionContextAction {
+    fn command(self) -> &'static str {
+        match self {
+            Self::Copy => "copy",
+            Self::Cut => "cut",
+            Self::Delete => "delete",
+        }
+    }
+}
+
+pub fn selection_context_select() -> Select<SelectionContextAction> {
+    Select::new(
+        "Selection",
+        [
+            SelectionContextAction::Copy,
+            SelectionContextAction::Cut,
+            SelectionContextAction::Delete,
+        ],
+        (),
+        |editor, action, event| {
+            if event == PromptEvent::Validate {
+                editor
+                    .devtui
+                    .requests
+                    .push_back(DevTuiRequest::SelectionAction(action.command()));
+            }
+        },
+    )
+}
+
