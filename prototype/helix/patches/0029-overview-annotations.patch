-        let _ = doc;
+        // An adjacent overview lane preserves the draggable thumb. VS Code's
+        // overview ruler likewise projects decorations by document position.
+        let marker_x = geometry.x.saturating_sub(1);
+        let row_for = |pos: usize| {
+            let line = doc.text().char_to_line(pos.min(doc.text().len_chars()));
+            geometry.track_top + ((line * geometry.track_height.saturating_sub(1) as usize)
+                / doc.text().len_lines().saturating_sub(1).max(1)) as u16
+        };
+        for (&name, &pos) in &doc.devtui_marks {
+            if let Some(cell) = surface.get_mut(marker_x, row_for(pos)) {
+                cell.set_symbol(&name.to_string()).set_style(editor.theme.get("ui.text.info"));
+            }
+        }
+        for hit in &doc.devtui_find_hits {
+            if let Some(cell) = surface.get_mut(marker_x, row_for(hit.start)) {
+                cell.set_symbol("s").set_style(editor.theme.get("ui.selection"));
+            }
+        }
+        for diagnostic in doc.diagnostics().iter().rev() {
+            let (symbol, scope) = match diagnostic.severity {
+                Some(helix_core::diagnostic::Severity::Error) => ("!", "error"),
+                Some(helix_core::diagnostic::Severity::Warning) => ("!", "warning"),
+                _ => ("i", "info"),
+            };
+            if let Some(cell) = surface.get_mut(marker_x, row_for(diagnostic.range.start)) {
+                cell.set_symbol(symbol).set_style(editor.theme.get(scope));
+            }
+        }
     }
 
