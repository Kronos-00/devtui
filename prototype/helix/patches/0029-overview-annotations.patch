+fn devtui_set_mark(cx: &mut Context) {
+    cx.editor.set_status("Set mark: enter a letter");
+    cx.on_next_key(|cx, key| {
+        if let Some(name) = key.char().filter(char::is_ascii_alphabetic) {
+            let (view, doc) = current!(cx.editor);
+            let pos = doc.selection(view.id).primary().cursor(doc.text().slice(..));
+            doc.devtui_marks.insert(name, pos);
+        }
+    });
+}
+
+fn devtui_goto_mark(cx: &mut Context) {
+    cx.editor.set_status("Go to mark: enter a letter");
+    cx.on_next_key(|cx, key| {
+        if let Some(name) = key.char() {
+            let (view, doc) = current!(cx.editor);
+            if let Some(&pos) = doc.devtui_marks.get(&name) {
+                doc.set_selection(view.id, Selection::point(pos.min(doc.text().len_chars())));
+                cx.editor.devtui.explicit_selection = false;
+            } else { cx.editor.set_status("Mark is not set in this document"); }
+        }
+    });
+}
+
+fn devtui_delete_mark(cx: &mut Context) {
+    cx.editor.set_status("Delete mark: enter a letter");
+    cx.on_next_key(|cx, key| {
+        if let Some(name) = key.char() { doc_mut!(cx.editor).devtui_marks.remove(&name); }
+    });
+}
+
