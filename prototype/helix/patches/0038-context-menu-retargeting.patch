     fn handle_event(&mut self, event: &Event, cx: &mut Context) -> EventResult {
+        if self.anchor.is_some() {
+            if let Event::Mouse(mouse) = event {
+                let outside = self.rendered_area.is_some_and(|area| {
+                    mouse.column < area.x
+                        || mouse.column >= area.right()
+                        || mouse.row < area.y
+                        || mouse.row >= area.bottom()
+                });
+                if mouse.kind == MouseEventKind::Down(MouseButton::Right) && outside {
+                    // Dismiss this context menu, then let the same right press
+                    // reach the editor and enqueue a fresh context/anchor.
+                    // The compositor runs the close callback before it opens
+                    // the newly queued menu. Modal confirmations do not bubble.
+                    return match self.options.handle_event(&Event::Key(key!(Esc)), cx) {
+                        EventResult::Consumed(callback) => EventResult::Ignored(callback),
+                        result => result,
+                    };
+                }
+            }
+        }
         self.options.handle_event(event, cx)
     }
 
