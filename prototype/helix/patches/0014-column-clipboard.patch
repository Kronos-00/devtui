+fn devtui_yank_filtered_to_clipboard(editor: &mut Editor) {
+    let (view, doc) = current!(editor);
+    let text = doc.text().slice(..);
+    let mut values: Vec<String> = doc
+        .selection(view.id)
+        .fragments(text)
+        .map(Cow::into_owned)
+        .collect();
+
+    // VS Code sparse column selections omit rows that do not participate in
+    // the rectangle. Helix can retain zero-width ranges for those rows, so
+    // keep ordinary single-cursor semantics but drop empty fragments whenever
+    // at least one real range exists in a multi-selection.
+    if editor.devtui.column_selection_active
+        && values.len() > 1
+        && values
+            .iter()
+            .any(|value| !value.trim_matches(['\r', '\n']).is_empty())
+    {
+        values.retain(|value| !value.trim_matches(['\r', '\n']).is_empty());
+    }
+
+    let selections = values.len();
+    match editor.registers.write('+', values) {
+        Ok(_) => editor.set_status(format!(
+            "copied {selections} selection{}",
+            if selections == 1 { "" } else { "s" }
+        )),
+        Err(err) => editor.set_error(err.to_string()),
+    }
+}
