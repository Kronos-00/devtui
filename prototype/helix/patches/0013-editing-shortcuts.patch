+pub fn current_replace_search_prompt(doc_id: DocumentId) -> Prompt {
+    Prompt::new(
+        Cow::Borrowed("Search: "),
+        Some('/'),
+        ui::completers::none,
+        move |cx, input, event| {
+            if event == PromptEvent::Validate && !input.is_empty() {
+                cx.editor
+                    .devtui
+                    .requests
+                    .push_back(DevTuiRequest::CurrentReplaceInput {
+                        doc_id,
+                        query: input.to_string(),
+                    });
+            }
+        },
+    )
+}
+
+pub fn current_replace_replacement_prompt(
+    editor: &Editor,
+    doc_id: DocumentId,
+    query: String,
+) -> Prompt {
+    Prompt::new(
+        Cow::Borrowed("Replace: "),
+        None,
+        ui::completers::none,
+        move |cx, input, event| {
+            if event == PromptEvent::Validate {
+                cx.editor
+                    .devtui
+                    .requests
+                    .push_back(DevTuiRequest::CurrentReplaceResults {
+                        doc_id,
+                        query: query.clone(),
+                        replacement: input.to_string(),
+                    });
+            }
+        },
+    )
+    .with_line(String::new(), editor)
+}
+
+pub fn current_replace_picker(
+    editor: &mut Editor,
+    doc_id: DocumentId,
+    query: String,
+    replacement: String,
+) -> anyhow::Result<Picker<ProjectReplaceItem, ProjectReplaceData>> {
+    let items = current_replace_scan(editor, doc_id, &query, &replacement)?;
+    let data = ProjectReplaceData;
+    let columns = [PickerColumn::new(
+        "pending replacement",
+        |item: &ProjectReplaceItem, _data: &ProjectReplaceData| match item {
+            ProjectReplaceItem::ReplaceFile { count, .. } => {
+                format!("Replace All in File ({count} matches)").into()
+            }
+            ProjectReplaceItem::Match { line, before, after, .. } => {
+                format!(
+                    "{}:{}  {}  →  {}",
+                    "current",
+                    line + 1,
+                    before.trim_end(),
+                    after.trim_end(),
+                )
+                .into()
+            }
+            ProjectReplaceItem::ReplaceAll { count } => {
+                format!("Replace All ({count} matches)").into()
+            }
+        },
+    )];
+
+    let action_query = query.clone();
+    let action_replacement = replacement.clone();
+    Ok(Picker::new(columns, 0, items, data, move |cx, item, _action| {
+        let result = match item {
+            ProjectReplaceItem::ReplaceFile { path, .. } => project_replace_apply(
+                cx.editor,
+                path,
+                &action_query,
+                &action_replacement,
+                None,
+            ),
+            ProjectReplaceItem::Match { path, ordinal, .. } => project_replace_apply(
+                cx.editor,
+                path,
+                &action_query,
+                &action_replacement,
+                Some(*ordinal),
+            ),
+            ProjectReplaceItem::ReplaceAll { .. } => Ok(0),
+        };
+        match result {
+            Ok(count) => cx.editor.set_status(format!(
+                "Replaced {count} match{}",
+                if count == 1 { "" } else { "es" }
+            )),
+            Err(err) => cx.editor.set_error(err.to_string()),
+        }
+    }))
+}
