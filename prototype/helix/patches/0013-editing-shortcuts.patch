+    let doc_id = view!(cx.editor).doc;
+    if doc!(cx.editor, &doc_id).path().is_none() {
+        cx.editor
+            .set_error("Save this file before using current-file Replace");
+        return;
+    }
+    cx.push_layer(Box::new(ui::devtui::current_replace_search_prompt(doc_id)));
+}
