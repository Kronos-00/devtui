+fn devtui_prepare_occurrence_selection(editor: &mut Editor) {
+    if editor.mode != Mode::Normal {
+        return;
+    }
+
+    let (view, doc) = current!(editor);
+    let current = doc.selection(view.id).clone();
+    if current.len() != 1 || current.primary().len() > 1 {
+        return;
+    }
+
+    let text = doc.text().slice(..);
+    let word = textobject::textobject_word(
+        text,
+        current.primary(),
+        textobject::TextObject::Inside,
+        1,
+        false,
+    );
+    if !word.is_empty() {
+        doc.set_selection(view.id, Selection::new(SmallVec::from_vec(vec![word]), 0));
+    }
+}
+
+fn devtui_add_next_occurrence(cx: &mut Context) {
+    devtui_prepare_occurrence_selection(cx.editor);
+    search_selection_detect_word_boundaries(cx);
+    extend_search_next(cx);
+}
+
+fn devtui_add_all_occurrences(cx: &mut Context) {
+    devtui_prepare_occurrence_selection(cx.editor);
+    search_selection_detect_word_boundaries(cx);
+
+    let register = cx.register.unwrap_or('/');
+    let Some(pattern) = cx
+        .editor
+        .registers
+        .read(register, cx.editor)
+        .and_then(|mut values| values.next().map(|value| value.into_owned()))
+    else {
+        return;
+    };
+    let is_crlf = doc!(cx.editor).line_ending == LineEnding::Crlf;
+    let Ok(regex) = rope::RegexBuilder::new()
+        .syntax(
+            rope::Config::new()
+                .multi_line(true)
+                .crlf(is_crlf),
+        )
+        .build(&pattern)
+    else {
+        return;
+    };
+
+    let (view, doc) = current!(cx.editor);
+    let text = doc.text().slice(..);
+    let whole = Selection::single(0, text.len_chars());
+    if let Some(selection) = selection::select_on_matches(text, &whole, &regex) {
+        doc.set_selection(view.id, selection);
+    }
+}
+
+fn devtui_symbol_context_menu(cx: &mut Context) {
+    cx.editor
+        .devtui
+        .requests
+        .push_back(helix_view::editor::DevTuiRequest::SymbolContext);
+}
