+// Adapter/debuggee processes use pipes or their own terminal. Inheriting the
+// editor's controlling terminal lets debugpy's launcher tcsetpgrp() move the
+// editor into the background and break terminal reads with EIO.
+fn isolate_adapter_terminal(command: &mut Command) {
+    #[cfg(unix)]
+    unsafe {
+        // setsid is async-signal-safe and performs no allocation in pre_exec.
+        command.pre_exec(|| {
+            if libc::setsid() == -1 {
+                Err(std::io::Error::last_os_error())
+            } else {
+                Ok(())
+            }
+        });
+    }
+    #[cfg(not(unix))]
+    let _ = command;
+}
+
