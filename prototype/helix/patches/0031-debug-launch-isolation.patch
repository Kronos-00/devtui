--- a/helix-dap/src/transport.rs
+++ b/helix-dap/src/transport.rs
@@ -196,7 +196,14 @@ fn process_response(&self, res: Response) -> Result<Response> {
                 self.id, res.message, res.body, res.request_seq, res.command
             );
 
-            Err(Error::Other(anyhow::format_err!("{:?}", res.body)))
+            // Many adapters send only `message`, not a structured error body.
+            // Reporting the absent body as "None" hides the actual launch error.
+            let message = res
+                .message
+                .filter(|text| !text.trim().is_empty())
+                .or_else(|| res.body.map(|body| body.to_string()))
+                .unwrap_or_else(|| "debug adapter request failed".to_string());
+            Err(Error::Other(anyhow::format_err!("{}: {}", res.command, message)))
         }
     }
 
