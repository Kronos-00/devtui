+/// Search controls are shared by Find and both Replace scopes. Their labels
+/// expose state; Alt+C/W/R and left-click toggle case/word/regular expression.
+pub struct DevTuiSearchPrompt {
+    prompt: Prompt,
+    find: bool,
+    area: helix_view::graphics::Rect,
+}
+impl DevTuiSearchPrompt {
+    fn new(prompt: Prompt, find: bool) -> Self { Self { prompt, find, area: Default::default() } }
+    fn toggle(&mut self, flag: char, cx: &mut crate::compositor::Context) {
+        match flag {
+            'c' => cx.editor.devtui.find_match_case = !cx.editor.devtui.find_match_case,
+            'w' => cx.editor.devtui.find_whole_word = !cx.editor.devtui.find_whole_word,
+            'r' => cx.editor.devtui.find_regex = !cx.editor.devtui.find_regex,
+            _ => return,
+        }
+        self.prompt.notify(cx, PromptEvent::Update);
+    }
+}
+impl crate::compositor::Component for DevTuiSearchPrompt {
+    fn handle_event(&mut self, event: &crate::compositor::Event, cx: &mut crate::compositor::Context) -> crate::compositor::EventResult {
+        use crate::compositor::{Event, EventResult};
+        use helix_view::{keyboard::{KeyCode, KeyModifiers}, input::{MouseButton, MouseEventKind}};
+        if let Event::Key(key) = event {
+            if key.modifiers.contains(KeyModifiers::ALT) {
+                if let KeyCode::Char(c @ ('c' | 'w' | 'r')) = key.code {
+                    self.toggle(c, cx); return EventResult::Consumed(None);
+                }
+            }
+            if self.find && key.code == KeyCode::Enter {
+                self.prompt.notify(cx, PromptEvent::Validate);
+                return EventResult::Consumed(None);
+            }
+        }
+        if let Event::Mouse(mouse) = event {
+            if mouse.kind == MouseEventKind::Down(MouseButton::Left) && mouse.row == self.area.bottom().saturating_sub(1) {
+                let x = mouse.column.saturating_sub(self.area.x);
+                let flag = if x < 5 { Some('c') } else if x < 10 { Some('w') } else if x < 15 { Some('r') } else { None };
+                if let Some(flag) = flag { self.toggle(flag, cx); return EventResult::Consumed(None); }
+            }
+        }
+        self.prompt.handle_event(event, cx)
+    }
+    fn render(&mut self, area: helix_view::graphics::Rect, surface: &mut Surface, cx: &mut crate::compositor::Context) {
+        self.area = area;
+        let mark = |yes| if yes { '+' } else { '-' };
+        let count = if self.find { cx.editor.devtui.find_result_count.map(|n| format!(" ({n} matches)")).unwrap_or_default() } else { String::new() };
+        self.prompt.set_label(format!("[Aa{}][W {}][.*{}] {}{}: ", mark(cx.editor.devtui.find_match_case), mark(cx.editor.devtui.find_whole_word), mark(cx.editor.devtui.find_regex), if self.find { "Find" } else { "Search" }, count));
+        self.prompt.render(area, surface, cx);
+    }
+    fn cursor(&self, area: helix_view::graphics::Rect, editor: &Editor) -> (Option<helix_core::Position>, helix_view::graphics::CursorKind) {
+        self.prompt.cursor(area, editor)
+    }
+}
+
+pub fn find_prompt(editor: &Editor) -> DevTuiSearchPrompt {
+    let view_id = editor.tree.focus;
+    let doc_id = editor.tree.get(view_id).doc;
+    let doc = editor.document(doc_id).expect("active document");
+    let start = doc.selection(view_id).primary().from();
+    let mut previous_query = String::new();
+    let mut current = start;
+    let prompt = Prompt::new(Cow::Borrowed("Find: "), None, ui::completers::none, move |cx, input, event| {
+        if event == PromptEvent::Abort || input.is_empty() { return; }
+        let Some(doc) = cx.editor.document(doc_id) else { return; };
+        let matcher = match project_replace_matcher(cx.editor, input) {
+            Ok(matcher) => matcher, Err(err) => { cx.editor.set_error(err.to_string()); return; }
+        };
+        let content = doc.text().to_string();
+        let changed = input != previous_query;
+        let offset = doc.text().char_to_byte(if changed { start } else { current }.min(doc.text().len_chars()));
+        let mut matches = Vec::new();
+        if let Err(err) = matcher.find_iter(content.as_bytes(), |m| { matches.push((m.start(), m.end())); true }) {
+            cx.editor.set_error(err.to_string()); return;
+        }
+        let chosen = matches.iter().copied().find(|(a, _)| if event == PromptEvent::Validate { *a > offset } else { *a >= offset }).or_else(|| matches.first().copied());
+        previous_query = input.to_string();
+        cx.editor.devtui.find_result_count = Some(matches.len());
+        if let Some((a,b)) = chosen {
+            let doc = cx.editor.document_mut(doc_id).unwrap();
+            let from = doc.text().byte_to_char(a); let to = doc.text().byte_to_char(b);
+            current = from;
+            doc.set_selection(view_id, helix_core::Selection::single(from,to));
+            cx.editor.devtui.explicit_selection = true;
+            cx.editor.ensure_cursor_in_view(view_id);
+            cx.editor.set_status(format!("{} matches",matches.len()));
+        } else { cx.editor.set_status("No results"); }
+    });
+    DevTuiSearchPrompt::new(prompt,true)
+}
