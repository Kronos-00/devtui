+#[derive(Clone, Copy, Debug, Default)]
+pub enum ExplorerAction {
+    #[default]
+    NewFile,
+    NewFolder,
+    Paste,
+    Copy,
+    CopyPath,
+    CopyRelativePath,
+    Rename,
+    Delete,
+}
+
+impl Item for ExplorerAction {
+    type Data = ();
+
+    fn format(&self, _data: &Self::Data) -> Row<'_> {
+        match self {
+            Self::NewFile => "New File",
+            Self::NewFolder => "New Folder",
+            Self::Paste => "Paste",
+            Self::Copy => "Copy",
+            Self::CopyPath => "Copy Path",
+            Self::CopyRelativePath => "Copy Relative Path",
+            Self::Rename => "Rename",
+            Self::Delete => "Delete",
+        }
+        .into()
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub enum DeleteChoice {
+    #[default]
+    Delete,
+    Cancel,
+}
+
+impl Item for DeleteChoice {
+    type Data = ();
+
+    fn format(&self, _data: &Self::Data) -> Row<'_> {
+        match self {
+            Self::Delete => "Delete",
+            Self::Cancel => "Cancel",
+        }
+        .into()
+    }
+}
+
+fn distinct_paths(mut paths: Vec<PathBuf>) -> Vec<PathBuf> {
+    paths.sort_by_key(|path| path.components().count());
+    let mut out: Vec<PathBuf> = Vec::new();
+    for path in paths {
+        if out.iter().any(|parent| path.starts_with(parent)) {
+            continue;
+        }
+        out.push(path);
+    }
+    out
+}
+
+fn clipboard_paths(editor: &mut Editor, root: &Path, paths: &[PathBuf], relative: bool) {
+    let values = paths
+        .iter()
+        .map(|path| {
+            if relative {
+                if path == root {
+                    ".".to_string()
+                } else {
+                    path.strip_prefix(root)
+                        .unwrap_or(path)
+                        .to_string_lossy()
+                        .into_owned()
+                }
+            } else {
+                path.to_string_lossy().into_owned()
+            }
+        })
+        .collect();
+    if let Err(err) = editor.registers.write('+', values) {
+        editor.set_error(err.to_string());
+    }
+}
+
+fn next_copy_destination(directory: &Path, source: &Path) -> PathBuf {
+    let name = source
+        .file_name()
+        .and_then(|name| name.to_str())
+        .unwrap_or("copy");
+    let (stem, extension) = if source.is_file() {
+        match (source.file_stem().and_then(|s| s.to_str()), source.extension().and_then(|s| s.to_str())) {
+            (Some(stem), Some(ext)) => (stem.to_string(), Some(ext.to_string())),
+            _ => (name.to_string(), None),
+        }
+    } else {
+        (name.to_string(), None)
+    };
+
+    let split_copy = |value: &str| -> (String, Option<u32>) {
+        if let Some((base, suffix)) = value.rsplit_once(" copy") {
+            if suffix.is_empty() {
+                return (base.to_string(), Some(2));
+            }
+            if let Ok(number) = suffix.trim_start().parse::<u32>() {
+                return (base.to_string(), Some(number.saturating_add(1)));
+            }
+        }
+        (value.to_string(), None)
+    };
+
+    let (base, mut number) = split_copy(&stem);
+    loop {
+        let copied_stem = match number {
+            None => format!("{base} copy"),
+            Some(number) => format!("{base} copy {number}"),
+        };
+        let filename = extension
+            .as_ref()
+            .map(|ext| format!("{copied_stem}.{ext}"))
+            .unwrap_or(copied_stem);
+        let candidate = directory.join(filename);
+        if !candidate.exists() {
+            return candidate;
+        }
+        number = Some(number.unwrap_or(1).saturating_add(1));
+    }
+}
+
+fn copy_path_recursive(editor: &mut Editor, source: &Path, destination: &Path) -> std::io::Result<()> {
+    if source.is_dir() {
+        editor.create_path(destination, true)?;
+        for entry in fs::read_dir(source)? {
+            let entry = entry?;
+            let child_source = entry.path();
+            let child_destination = destination.join(entry.file_name());
+            copy_path_recursive(editor, &child_source, &child_destination)?;
+        }
+    } else {
+        editor.create_path(destination, false)?;
+        fs::copy(source, destination)?;
+    }
+    Ok(())
+}
+
+pub fn paste_explorer_clipboard(editor: &mut Editor, directory: &Path) {
+    let sources = distinct_paths(editor.devtui.explorer_clipboard.clone());
+    for source in sources {
+        let mut destination = directory.join(source.file_name().unwrap_or_default());
+        if destination.exists() || destination == source {
+            destination = next_copy_destination(directory, &source);
+        }
+        if let Err(err) = copy_path_recursive(editor, &source, &destination) {
+            editor.set_error(format!("Paste failed: {err}"));
+            break;
+        }
+    }
+}
+
+pub fn explorer_context_select(
+    root: PathBuf,
+    target: PathBuf,
+    is_dir: bool,
+    is_root: bool,
+    selection: Vec<PathBuf>,
+) -> Select<ExplorerAction> {
+    let mut actions = Vec::new();
+    if is_dir {
+        actions.extend([
+            ExplorerAction::NewFile,
+            ExplorerAction::NewFolder,
+            ExplorerAction::Paste,
+        ]);
+    }
+    if !is_root {
+        actions.push(ExplorerAction::Copy);
+    }
+    actions.extend([
+        ExplorerAction::CopyPath,
+        ExplorerAction::CopyRelativePath,
+    ]);
+    if !is_root && selection.len() == 1 {
+        actions.push(ExplorerAction::Rename);
+    }
+    if !is_root {
+        actions.push(ExplorerAction::Delete);
+    }
+
+    Select::new("Explorer", actions, (), move |editor, action, event| {
+        if event != PromptEvent::Validate {
+            return;
+        }
+        match action {
+            ExplorerAction::NewFile => {
+                editor.devtui.requests.push_back(DevTuiRequest::ExplorerCreate {
+                    directory: target.clone(),
+                    is_dir: false,
+                });
+            }
+            ExplorerAction::NewFolder => {
+                editor.devtui.requests.push_back(DevTuiRequest::ExplorerCreate {
+                    directory: target.clone(),
+                    is_dir: true,
+                });
+            }
+            ExplorerAction::Paste => paste_explorer_clipboard(editor, &target),
+            ExplorerAction::Copy => {
+                editor.devtui.explorer_clipboard = distinct_paths(selection.clone());
+            }
+            ExplorerAction::CopyPath => clipboard_paths(editor, &root, &selection, false),
+            ExplorerAction::CopyRelativePath => clipboard_paths(editor, &root, &selection, true),
+            ExplorerAction::Rename => {
+                editor.devtui.requests.push_back(DevTuiRequest::ExplorerRename {
+                    path: target.clone(),
+                });
+            }
+            ExplorerAction::Delete => {
+                let paths = distinct_paths(selection.clone())
+                    .into_iter()
+                    .filter(|path| path != &root)
+                    .collect();
+                editor
+                    .devtui
+                    .requests
+                    .push_back(DevTuiRequest::ExplorerDelete { paths });
+            }
+        }
+    })
+}
+
+pub fn explorer_create_prompt(directory: PathBuf, is_dir: bool) -> Prompt {
+    let label = if is_dir { "New Folder: " } else { "New File: " };
+    Prompt::new(
+        Cow::Owned(label.to_string()),
+        None,
+        ui::completers::none,
+        move |cx, input, event| {
+            if event != PromptEvent::Validate {
+                return;
+            }
+            let name = input.trim();
+            if name.is_empty() {
+                return;
+            }
+            let path = directory.join(name);
+            if let Err(err) = cx.editor.create_path(&path, is_dir) {
+                cx.editor.set_error(err.to_string());
+            }
+        },
+    )
+}
+
+pub fn explorer_rename_prompt(editor: &Editor, path: PathBuf) -> Prompt {
+    let current_name = path
+        .file_name()
+        .and_then(|name| name.to_str())
+        .unwrap_or_default()
+        .to_string();
+    Prompt::new(
+        Cow::Borrowed("Rename: "),
+        None,
+        ui::completers::none,
+        move |cx, input, event| {
+            if event != PromptEvent::Validate {
+                return;
+            }
+            let name = input.trim();
+            if name.is_empty() {
+                return;
+            }
+            let destination = path
+                .parent()
+                .map(|parent| parent.join(name))
+                .unwrap_or_else(|| PathBuf::from(name));
+            if let Err(err) = cx.editor.move_path(&path, &destination) {
+                cx.editor.set_error(err.to_string());
+            }
+        },
+    )
+    .with_line(current_name, editor)
+}
+
+pub fn explorer_delete_select(paths: Vec<PathBuf>) -> Select<DeleteChoice> {
+    let count = paths.len();
+    let title = if count == 1 {
+        format!(
+            "Delete {}?",
+            paths[0]
+                .file_name()
+                .and_then(|name| name.to_str())
+                .unwrap_or("item")
+        )
+    } else {
+        format!("Delete {count} selected items?")
+    };
+
+    Select::new(
+        title,
+        [DeleteChoice::Delete, DeleteChoice::Cancel],
+        (),
+        move |editor, choice, event| {
+            if event != PromptEvent::Validate || !matches!(choice, DeleteChoice::Delete) {
+                return;
+            }
+            for path in &paths {
+                if let Err(err) = editor.delete_path(path, true) {
+                    editor.set_error(err.to_string());
+                    break;
+                }
+            }
+        },
+    )
+}
