+#[derive(Clone, Copy)]
+pub enum OverwriteChoice {
+    Replace,
+    Cancel,
+}
+
+impl Item for OverwriteChoice {
+    type Data = ();
+    fn format(&self, _data: &Self::Data) -> Row<'_> {
+        match self { Self::Replace => "Replace", Self::Cancel => "Cancel" }.into()
+    }
+}
+
+fn begin_save_as(editor: &mut Editor, doc_id: DocumentId, path: PathBuf, close_after_save: bool, force: bool) {
+    if editor.document(doc_id).is_none() { return; }
+    if let Some(other) = editor.document_by_path(&path) {
+        if other.id() != doc_id && other.is_modified() {
+            editor.set_error("Target has unsaved changes in another tab; save those changes first");
+            return;
+        }
+    }
+    if close_after_save { editor.devtui.close_after_save.insert(doc_id); }
+    if let Err(err) = editor.save(doc_id, Some(path), force) {
+        editor.devtui.close_after_save.remove(&doc_id);
+        editor.set_error(err.to_string());
+    }
+}
+
+pub fn overwrite_select(doc_id: DocumentId, path: PathBuf, close_after_save: bool) -> Select<OverwriteChoice> {
+    Select::new(
+        format!("Replace existing {}?", path.file_name().unwrap_or_default().to_string_lossy()),
+        [OverwriteChoice::Replace, OverwriteChoice::Cancel], (),
+        move |editor, choice, event| {
+            if event == PromptEvent::Validate && matches!(choice, OverwriteChoice::Replace) {
+                begin_save_as(editor, doc_id, path.clone(), close_after_save, true);
+            }
+        },
+    )
+}
