+
+/// VS Code's default vertical layout: below first, above if needed, then
+/// overlap within the viewport. Horizontal alignment flips to the left edge
+/// of the anchor when the preferred right-hand placement does not fit.
+fn context_menu_area(viewport: Rect, anchor: Position, width: u16, height: u16) -> Rect {
+    let width = width.min(viewport.width);
+    let height = height.min(viewport.height);
+    let row = anchor
+        .row
+        .saturating_sub(viewport.y as usize)
+        .min(viewport.height.saturating_sub(1) as usize) as u16;
+    let col = anchor
+        .col
+        .saturating_sub(viewport.x as usize)
+        .min(viewport.width.saturating_sub(1) as usize) as u16;
+    let below = row.saturating_add(1).min(viewport.height);
+    let y = if height <= viewport.height.saturating_sub(below) {
+        below
+    } else if height <= row {
+        row - height
+    } else {
+        viewport.height.saturating_sub(height)
+    };
+    // If vertical overlap is unavoidable, place beside the clicked cell.
+    let overlaps = y <= row && row < y.saturating_add(height);
+    let after = col + u16::from(overlaps);
+    let before = col + u16::from(!overlaps);
+    let x = if width <= viewport.width.saturating_sub(after) {
+        after
+    } else if width <= before {
+        before - width
+    } else {
+        viewport.width.saturating_sub(width)
+    };
+    Rect::new(viewport.x + x, viewport.y + y, width, height)
 }
 
