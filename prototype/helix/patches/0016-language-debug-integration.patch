+fn python_workspace_state_path() -> Option<PathBuf> {
+    let home = std::env::var_os("HOME").map(PathBuf::from)?;
+    let workspace = helix_stdx::path::canonicalize(&std::env::current_dir().ok()?);
+    let key = workspace
+        .as_os_str()
+        .to_string_lossy()
+        .as_bytes()
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect::<String>();
+    Some(
+        home.join(".local/state/devtui/helix-python-envs")
+            .join(key),
+    )
+}
+
+fn persist_python_environment(path: &Path) -> std::io::Result<()> {
+    let Some(state) = python_workspace_state_path() else {
+        return Ok(());
+    };
+    if let Some(parent) = state.parent() {
+        fs::create_dir_all(parent)?;
+    }
+    fs::write(state, path.to_string_lossy().as_bytes())
+}
+
+pub fn python_venv_prompt(editor: &Editor) -> Prompt {
+    let cwd = std::env::current_dir().unwrap_or_else(|_| PathBuf::from("."));
+    let default = [".venv", "venv"]
+        .into_iter()
+        .map(|name| cwd.join(name))
+        .find(|path| path.join("bin/python").is_file())
+        .unwrap_or_else(|| cwd.join(".venv"))
+        .to_string_lossy()
+        .into_owned();
+
+    Prompt::new(
+        Cow::Borrowed("Python Environment: "),
+        None,
+        ui::completers::filename,
+        move |cx, input, event| {
+            if event != PromptEvent::Validate || input.trim().is_empty() {
+                return;
+            }
+
+            let path = helix_stdx::path::canonicalize(Path::new(input));
+            let python = path.join("bin/python");
+            if !python.is_file() {
+                cx.editor
+                    .set_error(format!("Not a Python virtual environment: {}", path.display()));
+                return;
+            }
+
+            let bin = path.join("bin");
+            let old_path = std::env::var_os("PATH").unwrap_or_default();
+            let mut entries: Vec<PathBuf> = std::env::split_paths(&old_path).collect();
+            entries.retain(|entry| entry != &bin);
+            entries.insert(0, bin);
+            match std::env::join_paths(entries) {
+                Ok(new_path) => {
+                    std::env::set_var("VIRTUAL_ENV", &path);
+                    std::env::set_var("PATH", new_path);
+                    if let Err(err) = persist_python_environment(&path) {
+                        cx.editor.set_error(err.to_string());
+                        return;
+                    }
+                    if let Err(err) = crate::commands::typed::lsp_restart(
+                        cx,
+                        helix_core::command_line::Args::default(),
+                        PromptEvent::Validate,
+                    ) {
+                        cx.editor.set_error(err.to_string());
+                    } else {
+                        cx.editor
+                            .set_status(format!("Python environment: {}", path.display()));
+                    }
+                }
+                Err(err) => cx.editor.set_error(err.to_string()),
+            }
+        },
+    )
+    .with_line(default, editor)
+}
+#[derive(Clone, Debug)]
+pub struct LspInfoItem {
+    pub name: String,
+    pub id: String,
+}
+
+impl Item for LspInfoItem {
+    type Data = ();
+
+    fn format(&self, _data: &Self::Data) -> Row<'_> {
+        format!("{}  [{}]", self.name, self.id).into()
+    }
+}
+
+pub fn lsp_info_select(editor: &Editor) -> Option<Select<LspInfoItem>> {
+    let doc = editor.document(editor.tree.get(editor.tree.focus).doc)?;
+    let items = doc
+        .language_servers()
+        .map(|server| LspInfoItem {
+            name: server.name().to_string(),
+            id: server.id().to_string(),
+        })
+        .collect::<Vec<_>>();
+
+    if items.is_empty() {
+        return None;
+    }
+
+    Some(Select::new(
+        "Language Servers",
+        items,
+        (),
+        |_editor, _item, _event| {},
+    ))
+}
