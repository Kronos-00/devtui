@@ -0,0 +1,1286 @@
+//! Non-modal, editor-anchored Find/Replace overlay.
+use crate::compositor::{Component, Context, Event, EventResult};
+use helix_core::{
+    unicode::{segmentation::UnicodeSegmentation, width::UnicodeWidthStr},
+    Position, Selection, Transaction,
+};
+use helix_view::{
+    devtui_find::{in_scope, whole_word, Replacement, SearchOptions, SearchText},
+    graphics::{CursorKind, Modifier, Rect},
+    input::{KeyEvent, MouseButton, MouseEventKind},
+    keyboard::{KeyCode, KeyModifiers},
+    DocumentId, Editor, ViewId,
+};
+use std::{
+    ops::Range,
+    time::{Duration, Instant},
+};
+use tui::buffer::Buffer as Surface;
+
+pub const ID: &str = "devtui-find-widget";
+const DEFAULT_WIDTH: u16 = 64;
+const MIN_WIDTH: u16 = 44;
+fn hit(rect: Rect, x: u16, y: u16) -> bool {
+    x >= rect.x && x < rect.right() && y >= rect.y && y < rect.bottom()
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Control {
+    Find,
+    Replace,
+    Case,
+    Word,
+    Regex,
+    Previous,
+    Next,
+    Scope,
+    Close,
+    Preserve,
+    ReplaceOne,
+    ReplaceAll,
+    Expand,
+}
+impl Control {
+    fn tip(self) -> &'static str {
+        match self {
+            Self::Find => "Find: Enter / Shift+Enter = next / previous",
+            Self::Replace => "Replace: Enter = replace; Ctrl+Alt+Enter = all",
+            Self::Case => "Match Case (Alt+C)",
+            Self::Word => "Match Whole Word (Alt+W)",
+            Self::Regex => "Regular Expression (Alt+R)",
+            Self::Previous => "Previous Match (Shift+Enter)",
+            Self::Next => "Next Match (Enter)",
+            Self::Scope => "Find in Selection (Alt+L)",
+            Self::Close => "Close (Esc)",
+            Self::Preserve => "Preserve Case (Alt+P)",
+            Self::ReplaceOne => "Replace (Enter in Replace)",
+            Self::ReplaceAll => "Replace All (Ctrl+Alt+Enter)",
+            Self::Expand => "Toggle Replace",
+        }
+    }
+}
+
+#[derive(Default)]
+struct Field {
+    text: String,
+    cursor: usize,
+    anchor: usize,
+    scroll: usize,
+    top: usize,
+    area: Rect,
+    caret: Option<Position>,
+    undo: Vec<(String, usize, usize)>,
+    redo: Vec<(String, usize, usize)>,
+}
+impl Field {
+    fn new(text: String) -> Self {
+        let end = text.len();
+        Self {
+            text,
+            cursor: end,
+            anchor: 0,
+            ..Self::default()
+        }
+    }
+    fn selection(&self) -> Range<usize> {
+        self.anchor.min(self.cursor)..self.anchor.max(self.cursor)
+    }
+    fn save_undo(&mut self) {
+        self.undo
+            .push((self.text.clone(), self.cursor, self.anchor));
+        if self.undo.len() > 100 {
+            self.undo.remove(0);
+        }
+        self.redo.clear();
+    }
+    fn insert(&mut self, value: &str) {
+        self.save_undo();
+        let range = self.selection();
+        self.cursor = range.start + value.len();
+        self.text.replace_range(range, value);
+        self.anchor = self.cursor;
+    }
+    fn previous(&self, pos: usize) -> usize {
+        self.text[..pos]
+            .grapheme_indices(true)
+            .next_back()
+            .map_or(0, |(i, _)| i)
+    }
+    fn next(&self, pos: usize) -> usize {
+        self.text[pos..]
+            .graphemes(true)
+            .next()
+            .map_or(pos, |s| pos + s.len())
+    }
+    fn move_to(&mut self, pos: usize, shift: bool) {
+        self.cursor = pos;
+        if !shift {
+            self.anchor = pos;
+        }
+    }
+    fn key(&mut self, key: KeyEvent, editor: &mut Editor) -> bool {
+        let ctrl = key.modifiers.contains(KeyModifiers::CONTROL);
+        let shift = key.modifiers.contains(KeyModifiers::SHIFT);
+        let alt = key.modifiers.contains(KeyModifiers::ALT);
+        if ctrl {
+            match key.code {
+                KeyCode::Char('a') => {
+                    self.anchor = 0;
+                    self.cursor = self.text.len();
+                }
+                KeyCode::Char('u') => {
+                    self.anchor = 0;
+                    self.insert("");
+                }
+                KeyCode::Char('k') => {
+                    self.anchor = self.text.len();
+                    self.insert("");
+                }
+                KeyCode::Char('c' | 'x') => {
+                    let range = self.selection();
+                    if !range.is_empty() {
+                        if let Err(err) = editor
+                            .registers
+                            .write('+', vec![self.text[range].to_owned()])
+                        {
+                            editor.set_error(err.to_string());
+                        }
+                        if key.code == KeyCode::Char('x') {
+                            self.insert("");
+                        }
+                    }
+                }
+                KeyCode::Char('v') => {
+                    let value = editor
+                        .registers
+                        .first('+', editor)
+                        .unwrap_or_default()
+                        .into_owned();
+                    self.insert(&value.replace("\r\n", "\n"));
+                }
+                KeyCode::Char('z' | 'y') => {
+                    let redo = key.code == KeyCode::Char('y') || shift;
+                    let from = if redo { &mut self.redo } else { &mut self.undo };
+                    if let Some(state) = from.pop() {
+                        let old = (self.text.clone(), self.cursor, self.anchor);
+                        (self.text, self.cursor, self.anchor) = state;
+                        if redo {
+                            self.undo.push(old);
+                        } else {
+                            self.redo.push(old);
+                        }
+                    }
+                }
+                KeyCode::Left | KeyCode::Right => {
+                    let back = key.code == KeyCode::Left;
+                    let mut pos = self.cursor;
+                    if back {
+                        while pos > 0
+                            && self.text[..pos]
+                                .chars()
+                                .next_back()
+                                .is_some_and(char::is_whitespace)
+                        {
+                            pos = self.previous(pos);
+                        }
+                        while pos > 0
+                            && self.text[..pos]
+                                .chars()
+                                .next_back()
+                                .is_some_and(|c| !c.is_whitespace())
+                        {
+                            pos = self.previous(pos);
+                        }
+                    } else {
+                        while pos < self.text.len()
+                            && self.text[pos..]
+                                .chars()
+                                .next()
+                                .is_some_and(|c| !c.is_whitespace())
+                        {
+                            pos = self.next(pos);
+                        }
+                        while pos < self.text.len()
+                            && self.text[pos..]
+                                .chars()
+                                .next()
+                                .is_some_and(char::is_whitespace)
+                        {
+                            pos = self.next(pos);
+                        }
+                    }
+                    self.move_to(pos, shift);
+                }
+                KeyCode::Backspace | KeyCode::Delete => {
+                    if self.selection().is_empty() {
+                        let back = key.code == KeyCode::Backspace;
+                        let mut pos = self.cursor;
+                        while (back && pos > 0) || (!back && pos < self.text.len()) {
+                            let next = if back {
+                                self.previous(pos)
+                            } else {
+                                self.next(pos)
+                            };
+                            let piece = &self.text[pos.min(next)..pos.max(next)];
+                            pos = next;
+                            if piece.chars().any(char::is_whitespace) {
+                                break;
+                            }
+                        }
+                        self.anchor = pos;
+                    }
+                    self.insert("");
+                }
+                KeyCode::Home => self.move_to(0, shift),
+                KeyCode::End => self.move_to(self.text.len(), shift),
+                KeyCode::Enter => self.insert("\n"),
+                _ => return false,
+            }
+            return true;
+        }
+        if alt {
+            return false;
+        }
+        match key.code {
+            KeyCode::Char(ch) => self.insert(&ch.to_string()),
+            KeyCode::Left | KeyCode::Right => {
+                let range = self.selection();
+                let pos = if key.code == KeyCode::Left {
+                    if !shift && !range.is_empty() {
+                        range.start
+                    } else {
+                        self.previous(self.cursor)
+                    }
+                } else if !shift && !range.is_empty() {
+                    range.end
+                } else {
+                    self.next(self.cursor)
+                };
+                self.move_to(pos, shift);
+            }
+            KeyCode::Home => {
+                let pos = self.text[..self.cursor].rfind('\n').map_or(0, |i| i + 1);
+                self.move_to(pos, shift);
+            }
+            KeyCode::End => {
+                let pos = self.text[self.cursor..]
+                    .find('\n')
+                    .map_or(self.text.len(), |i| i + self.cursor);
+                self.move_to(pos, shift);
+            }
+            KeyCode::Up | KeyCode::Down => {
+                let starts = self.line_starts();
+                let line = starts
+                    .partition_point(|&i| i <= self.cursor)
+                    .saturating_sub(1);
+                let col = self.text[starts[line]..self.cursor].graphemes(true).count();
+                let target = if key.code == KeyCode::Up {
+                    line.saturating_sub(1)
+                } else {
+                    (line + 1).min(starts.len() - 1)
+                };
+                let end = self.text[starts[target]..]
+                    .find('\n')
+                    .map_or(self.text.len(), |i| starts[target] + i);
+                let pos = self.text[starts[target]..end]
+                    .grapheme_indices(true)
+                    .nth(col)
+                    .map_or(end, |(i, _)| starts[target] + i);
+                self.move_to(pos, shift);
+            }
+            KeyCode::Backspace | KeyCode::Delete => {
+                if self.selection().is_empty() {
+                    self.anchor = if key.code == KeyCode::Backspace {
+                        self.previous(self.cursor)
+                    } else {
+                        self.next(self.cursor)
+                    };
+                }
+                self.insert("");
+            }
+            _ => return false,
+        }
+        true
+    }
+    fn line_starts(&self) -> Vec<usize> {
+        std::iter::once(0)
+            .chain(self.text.match_indices('\n').map(|(i, _)| i + 1))
+            .collect()
+    }
+    fn height(&self) -> u16 {
+        self.line_starts().len().min(3) as u16
+    }
+    fn pointer(&mut self, x: u16, y: u16, extend: bool) {
+        let starts = self.line_starts();
+        let line = (self.top + y.saturating_sub(self.area.y) as usize).min(starts.len() - 1);
+        let end = self.text[starts[line]..]
+            .find('\n')
+            .map_or(self.text.len(), |i| starts[line] + i);
+        let mut col = 0;
+        let mut pos = end;
+        let begin = (starts[line] + self.scroll.min(end - starts[line])).min(end);
+        let begin = self.text.floor_char_boundary(begin);
+        for (i, g) in self.text[begin..end].grapheme_indices(true) {
+            let width = if g == "\t" { 4 } else { g.width().max(1) };
+            if col + width / 2 >= x.saturating_sub(self.area.x) as usize {
+                pos = begin + i;
+                break;
+            }
+            col += width;
+        }
+        self.move_to(pos, extend);
+    }
+    fn render(&mut self, area: Rect, surface: &mut Surface, editor: &Editor, focused: bool) {
+        self.area = area;
+        self.caret = None;
+        if area.width == 0 || area.height == 0 {
+            return;
+        }
+        let starts = self.line_starts();
+        let line = starts
+            .partition_point(|&i| i <= self.cursor)
+            .saturating_sub(1);
+        if line < self.top {
+            self.top = line;
+        } else if line >= self.top + area.height as usize {
+            self.top = line + 1 - area.height as usize;
+        }
+        let col = self.cursor - starts[line];
+        if self.scroll > col {
+            self.scroll = col;
+        }
+        let mut start = self
+            .text
+            .floor_char_boundary(starts[line] + self.scroll.min(col));
+        while self.text[start..self.cursor].replace('\t', "    ").width() >= area.width as usize
+            && start < self.cursor
+        {
+            start = self.next(start);
+        }
+        self.scroll = start - starts[line];
+        let range = self.selection();
+        for (row, &base) in starts
+            .iter()
+            .enumerate()
+            .skip(self.top)
+            .take(area.height as usize)
+        {
+            let end = self.text[base..]
+                .find('\n')
+                .map_or(self.text.len(), |i| base + i);
+            let start = self
+                .text
+                .floor_char_boundary(base + self.scroll.min(end - base));
+            let mut x = area.x;
+            let y = area.y + (row - self.top) as u16;
+            for (i, g) in self.text[start..end].grapheme_indices(true) {
+                let width = if g == "\t" { 4 } else { g.width().max(1) } as u16;
+                if x + width > area.right() {
+                    break;
+                }
+                let pos = start + i;
+                if pos == self.cursor {
+                    self.caret = Some(Position::new(y as usize, x as usize));
+                }
+                let style = editor
+                    .theme
+                    .get(if focused && pos >= range.start && pos < range.end {
+                        "ui.selection"
+                    } else {
+                        "ui.text"
+                    });
+                surface.set_stringn(
+                    x,
+                    y,
+                    if g == "\t" { "    " } else { g },
+                    width as usize,
+                    style,
+                );
+                x += width;
+            }
+            if self.cursor == end {
+                self.caret = Some(Position::new(y as usize, x.min(area.right() - 1) as usize));
+            }
+        }
+    }
+}
+
+pub struct FindWidget {
+    doc: DocumentId,
+    view: ViewId,
+    find: Field,
+    replace: Field,
+    expanded: bool,
+    focus: Option<Control>,
+    area: Rect,
+    buttons: Vec<(Rect, Control)>,
+    resizing: bool,
+    selecting: Option<Control>,
+    sash_click: Option<Instant>,
+    initial_scopes: Vec<Range<usize>>,
+    use_initial_scopes: bool,
+    version: i32,
+    error: Option<String>,
+    note: Option<String>,
+    hover: Option<Control>,
+}
+impl FindWidget {
+    pub fn open(editor: &mut Editor, expanded: bool) -> Self {
+        let view = editor.tree.focus;
+        let doc = editor.tree.get(view).doc;
+        let mut result = Self {
+            doc,
+            view,
+            find: Field::new(editor.devtui.find_query.clone()),
+            replace: Field::new(editor.devtui.find_replacement.clone()),
+            expanded,
+            focus: Some(Control::Find),
+            area: Rect::default(),
+            buttons: Vec::new(),
+            resizing: false,
+            selecting: None,
+            sash_click: None,
+            initial_scopes: Vec::new(),
+            use_initial_scopes: true,
+            version: -1,
+            error: None,
+            note: None,
+            hover: None,
+        };
+        result.initial_scopes = Self::selections(editor, doc, view);
+        if !expanded || result.single_selection(editor) {
+            result.seed(editor);
+            if expanded {
+                result.focus = Some(Control::Replace);
+            }
+        }
+        result.refresh(editor, true);
+        result
+    }
+    fn options(editor: &Editor) -> SearchOptions {
+        SearchOptions {
+            regex: editor.devtui.find_regex,
+            match_case: editor.devtui.find_match_case,
+            whole_word: editor.devtui.find_whole_word,
+        }
+    }
+    fn single_selection(&self, editor: &Editor) -> bool {
+        let doc = editor.document(self.doc).unwrap();
+        let range = doc.selection(self.view).primary();
+        editor.devtui.explicit_selection
+            && range.from() != range.to()
+            && doc.text().char_to_line(range.from()) == doc.text().char_to_line(range.to())
+    }
+    fn seed(&mut self, editor: &Editor) {
+        self.initial_scopes = Self::selections(editor, self.doc, self.view);
+        let doc = editor.document(self.doc).unwrap();
+        let selection = doc.selection(self.view).primary();
+        let selected = editor.devtui.explicit_selection && selection.from() != selection.to();
+        let range = if selected {
+            selection
+        } else {
+            super::editor::devtui_word_range(doc.text().slice(..), selection.from())
+        };
+        let text = doc.text().slice(range.from()..range.to()).to_string();
+        if !text.is_empty() && !text.contains(['\r', '\n']) {
+            self.find = Field::new(if editor.devtui.find_regex {
+                helix_core::regex::escape(&text)
+            } else {
+                text
+            });
+        }
+    }
+    fn selections(editor: &Editor, id: DocumentId, view: ViewId) -> Vec<Range<usize>> {
+        if !editor.devtui.explicit_selection {
+            return Vec::new();
+        }
+        let Some(doc) = editor.document(id) else {
+            return Vec::new();
+        };
+        doc.selection(view)
+            .ranges()
+            .iter()
+            .filter_map(|range| {
+                let start = range.from();
+                let mut end = range.to();
+                if end > start {
+                    let line = doc.text().char_to_line(end);
+                    if end == doc.text().line_to_char(line) && line > doc.text().char_to_line(start)
+                    {
+                        end = helix_core::line_ending::line_end_char_index(
+                            &doc.text().slice(..),
+                            line - 1,
+                        );
+                    }
+                }
+                (end > start).then_some(start..end)
+            })
+            .collect()
+    }
+    fn bind(&mut self, editor: &mut Editor) {
+        let view = editor.tree.focus;
+        let doc = editor.tree.get(view).doc;
+        if self.view != view || self.doc != doc {
+            if let Some(old) = editor.document_mut(self.doc) {
+                old.devtui_find_pattern = None;
+                old.devtui_find_hits.clear();
+                old.devtui_find_scopes = None;
+            }
+            // Explicit/column selection flags describe the previous active
+            // document. A block cursor in the new document is not a selection.
+            if self.doc != doc {
+                editor.devtui.explicit_selection = false;
+                editor.devtui.column_selection_active = false;
+                editor.devtui.column_selection = None;
+            }
+            self.doc = doc;
+            self.view = view;
+            self.initial_scopes = Self::selections(editor, doc, view);
+            self.use_initial_scopes = true;
+            self.version = -1;
+            self.refresh(editor, false);
+        }
+    }
+    fn refresh(&mut self, editor: &mut Editor, choose: bool) {
+        editor.devtui.find_query = self.find.text.clone();
+        editor.devtui.find_replacement = self.replace.text.clone();
+        let compiled = if self.find.text.is_empty() {
+            Ok(None)
+        } else {
+            Self::options(editor).compile(&self.find.text).map(Some)
+        };
+        self.error = compiled.as_ref().err().map(|err| {
+            err.to_string()
+                .lines()
+                .last()
+                .unwrap_or("Invalid regular expression")
+                .trim()
+                .to_owned()
+        });
+        let word = editor.devtui.find_whole_word;
+        if let Some(doc) = editor.document_mut(self.doc) {
+            doc.devtui_find_pattern = compiled.ok().flatten();
+            doc.devtui_find_whole_word = word;
+            doc.devtui_refresh_find_hits();
+            self.version = doc.version();
+            editor.devtui.find_result_count = Some(doc.devtui_find_hits.len());
+        }
+        if choose {
+            self.navigate(editor, 0);
+        }
+    }
+    fn navigate(&mut self, editor: &mut Editor, direction: i8) {
+        let Some(doc) = editor.document_mut(self.doc) else {
+            return;
+        };
+        let hits = &doc.devtui_find_hits;
+        if hits.is_empty() {
+            return;
+        }
+        let selection = doc.selection(self.view).primary();
+        let offset = selection.from();
+        let current = hits
+            .iter()
+            .position(|hit| hit.start == selection.from() && hit.end == selection.to());
+        let index = if direction > 0 {
+            current
+                .map(|i| (i + 1) % hits.len())
+                .unwrap_or_else(|| hits.iter().position(|r| r.start >= offset).unwrap_or(0))
+        } else if direction < 0 {
+            current
+                .map(|i| (i + hits.len() - 1) % hits.len())
+                .unwrap_or_else(|| {
+                    hits.iter()
+                        .rposition(|r| r.start < offset)
+                        .unwrap_or(hits.len() - 1)
+                })
+        } else {
+            hits.iter().position(|r| r.start >= offset).unwrap_or(0)
+        };
+        let range = hits[index].clone();
+        doc.set_selection(self.view, Selection::single(range.start, range.end));
+        editor.devtui.explicit_selection = true;
+        editor.ensure_cursor_in_view(self.view);
+    }
+    fn toggle_scope(&mut self, editor: &mut Editor) {
+        let active = editor
+            .document(self.doc)
+            .is_some_and(|d| d.devtui_find_scopes.is_some());
+        let scopes = if active {
+            None
+        } else {
+            let scopes = if self.use_initial_scopes && !self.initial_scopes.is_empty() {
+                self.initial_scopes.clone()
+            } else {
+                Self::selections(editor, self.doc, self.view)
+            };
+            if scopes.is_empty() {
+                self.note = Some("Select text in the editor first".into());
+                return;
+            }
+            Some(scopes)
+        };
+        if let Some(doc) = editor.document_mut(self.doc) {
+            doc.devtui_find_scopes = scopes;
+        }
+        self.refresh(editor, true);
+    }
+    fn replace_matches(&mut self, editor: &mut Editor, all: bool) {
+        self.refresh(editor, false);
+        if self.error.is_some() || self.find.text.is_empty() {
+            return;
+        }
+        let Some(doc) = editor.document(self.doc) else {
+            return;
+        };
+        if doc.readonly {
+            self.note = Some("Editor is read-only".into());
+            return;
+        }
+        let Some(regex) = doc.devtui_find_pattern.as_ref() else {
+            return;
+        };
+        let selected = doc.selection(self.view).primary();
+        let selection = selected.from()..selected.to();
+        if !all && !doc.devtui_find_hits.contains(&selection) {
+            self.navigate(editor, 0);
+            return;
+        }
+        let text = doc.text().to_string();
+        let replacement = Replacement::parse(&self.replace.text, editor.devtui.find_regex);
+        let normalized = SearchText::new(&text);
+        let mut changes = Vec::new();
+        for caps in regex.captures_iter(&normalized.text) {
+            let hit = caps.get(0).unwrap();
+            let range = doc
+                .text()
+                .byte_to_char(normalized.original_offset(hit.start()))
+                ..doc
+                    .text()
+                    .byte_to_char(normalized.original_offset(hit.end()));
+            if !in_scope(&range, doc.devtui_find_scopes.as_deref())
+                || (doc.devtui_find_whole_word && !whole_word(&normalized.text, hit.range()))
+                || (!all && range != selection)
+            {
+                continue;
+            }
+            let groups: Vec<_> = (0..caps.len())
+                .map(|i| caps.get(i).map(|m| m.as_str()))
+                .collect();
+            let value = replacement
+                .expand(&groups, editor.devtui.find_preserve_case)
+                .replace("\r\n", "\n")
+                .replace('\n', doc.line_ending.as_str());
+            changes.push((range.start, range.end, Some(value.into())));
+            if !all {
+                break;
+            }
+        }
+        let count = changes.len();
+        if count == 0 {
+            return;
+        }
+        let next = changes[0].0
+            + changes[0]
+                .2
+                .as_ref()
+                .map_or(0, |s: &helix_core::Tendril| s.chars().count());
+        let empty = changes[0].0 == changes[0].1;
+        let tx = Transaction::change(doc.text(), changes.into_iter());
+        let view = editor.tree.get_mut(self.view);
+        let doc = editor.documents.get_mut(&self.doc).unwrap();
+        doc.append_changes_to_history(view);
+        doc.apply(&tx, self.view);
+        doc.append_changes_to_history(view);
+        if !all {
+            let start = doc
+                .devtui_find_hits
+                .iter()
+                .find(|r| r.start >= next && (!empty || r.start > next))
+                .or_else(|| doc.devtui_find_hits.first())
+                .cloned();
+            if let Some(hit) = start {
+                doc.set_selection(self.view, Selection::single(hit.start, hit.end));
+            }
+        }
+        editor.ensure_cursor_in_view(self.view);
+        self.refresh(editor, false);
+        self.note = Some(format!(
+            "Replaced {count} match{}",
+            if count == 1 { "" } else { "es" }
+        ));
+    }
+    fn activate(&mut self, control: Control, editor: &mut Editor) {
+        self.note = None;
+        match control {
+            Control::Case => editor.devtui.find_match_case = !editor.devtui.find_match_case,
+            Control::Word => editor.devtui.find_whole_word = !editor.devtui.find_whole_word,
+            Control::Regex => editor.devtui.find_regex = !editor.devtui.find_regex,
+            Control::Preserve => {
+                editor.devtui.find_preserve_case = !editor.devtui.find_preserve_case;
+                return;
+            }
+            Control::Previous => {
+                self.navigate(editor, -1);
+                return;
+            }
+            Control::Next => {
+                self.navigate(editor, 1);
+                return;
+            }
+            Control::Scope => {
+                self.toggle_scope(editor);
+                return;
+            }
+            Control::Expand => {
+                self.expanded = !self.expanded;
+                self.focus = Some(Control::Find);
+                return;
+            }
+            Control::ReplaceOne => {
+                self.replace_matches(editor, false);
+                return;
+            }
+            Control::ReplaceAll => {
+                self.replace_matches(editor, true);
+                return;
+            }
+            _ => return,
+        }
+        self.refresh(editor, true);
+    }
+    fn close(&mut self, editor: &mut Editor) -> EventResult {
+        if let Some(doc) = editor.document_mut(self.doc) {
+            doc.devtui_find_pattern = None;
+            doc.devtui_find_hits.clear();
+            doc.devtui_find_scopes = None;
+        }
+        EventResult::Consumed(Some(Box::new(|compositor, _| {
+            compositor.remove(ID);
+        })))
+    }
+    fn field(&mut self, control: Control) -> &mut Field {
+        if control == Control::Replace {
+            &mut self.replace
+        } else {
+            &mut self.find
+        }
+    }
+    fn cycle(&mut self, backwards: bool) {
+        let mut order = vec![Control::Find];
+        if self.expanded {
+            order.push(Control::Replace);
+        }
+        order.extend([
+            Control::Case,
+            Control::Word,
+            Control::Regex,
+            Control::Previous,
+            Control::Next,
+            Control::Scope,
+            Control::Close,
+        ]);
+        if self.expanded {
+            order.extend([Control::Preserve, Control::ReplaceOne, Control::ReplaceAll]);
+        }
+        order.push(Control::Expand);
+        let current = order
+            .iter()
+            .position(|x| Some(*x) == self.focus)
+            .unwrap_or(0);
+        self.focus =
+            Some(order[(current + if backwards { order.len() - 1 } else { 1 }) % order.len()]);
+    }
+    fn button(
+        &mut self,
+        rect: Rect,
+        control: Control,
+        label: &str,
+        active: bool,
+        enabled: bool,
+        surface: &mut Surface,
+        editor: &Editor,
+    ) {
+        if rect.width == 0 {
+            return;
+        }
+        self.buttons.push((rect, control));
+        let mut style = editor.theme.get(if active {
+            "ui.menu.selected"
+        } else if !enabled {
+            "ui.text.inactive"
+        } else {
+            "ui.text"
+        });
+        if self.focus == Some(control) || self.hover == Some(control) {
+            style = style.add_modifier(Modifier::BOLD);
+        }
+        surface.set_stringn(rect.x, rect.y, label, rect.width as usize, style);
+    }
+}
+impl Component for FindWidget {
+    fn id(&self) -> Option<&'static str> {
+        Some(ID)
+    }
+    fn handle_event(&mut self, event: &Event, cx: &mut Context) -> EventResult {
+        self.bind(cx.editor);
+        match event {
+            Event::Resize(..) => {
+                self.resizing = false;
+                self.selecting = None;
+                return EventResult::Ignored(None);
+            }
+            Event::Mouse(mouse) => {
+                if self.resizing {
+                    match mouse.kind {
+                        MouseEventKind::Drag(MouseButton::Left) => {
+                            self.sash_click = None;
+                            let view = cx.editor.tree.get(self.view);
+                            let doc = cx.editor.document(self.doc).unwrap();
+                            let inner = view.inner_area(doc);
+                            cx.editor.devtui.find_widget_width = Some(
+                                inner
+                                    .right()
+                                    .saturating_sub(mouse.column)
+                                    .clamp(MIN_WIDTH.min(inner.width), inner.width),
+                            );
+                        }
+                        MouseEventKind::Up(MouseButton::Left) => self.resizing = false,
+                        _ => {}
+                    }
+                    return EventResult::Consumed(None);
+                }
+                if let Some(control) = self.selecting {
+                    match mouse.kind {
+                        MouseEventKind::Drag(MouseButton::Left) => {
+                            self.field(control).pointer(mouse.column, mouse.row, true)
+                        }
+                        MouseEventKind::Up(MouseButton::Left) => self.selecting = None,
+                        _ => {}
+                    }
+                    return EventResult::Consumed(None);
+                }
+                let inside = hit(self.area, mouse.column, mouse.row);
+                let target = self
+                    .buttons
+                    .iter()
+                    .find_map(|(r, c)| hit(*r, mouse.column, mouse.row).then_some(*c));
+                if mouse.kind == MouseEventKind::Down(MouseButton::Left) {
+                    if inside && mouse.column == self.area.x {
+                        let now = Instant::now();
+                        if self.sash_click.is_some_and(|last| {
+                            now.duration_since(last) < Duration::from_millis(350)
+                        }) {
+                            let view = cx.editor.tree.get(self.view);
+                            let doc = cx.editor.document(self.doc).unwrap();
+                            let width = view.inner_area(doc).width;
+                            cx.editor.devtui.find_widget_width =
+                                Some(if self.area.width >= width {
+                                    DEFAULT_WIDTH
+                                } else {
+                                    width
+                                });
+                            self.sash_click = None;
+                        } else {
+                            self.sash_click = Some(now);
+                            self.resizing = true;
+                        }
+                        return EventResult::Consumed(None);
+                    }
+                    if let Some(control) = target {
+                        if control == Control::Close {
+                            return self.close(cx.editor);
+                        }
+                        self.activate(control, cx.editor);
+                        return EventResult::Consumed(None);
+                    }
+                    for control in [Control::Find, Control::Replace] {
+                        if (control != Control::Replace || self.expanded)
+                            && hit(self.field(control).area, mouse.column, mouse.row)
+                        {
+                            self.focus = Some(control);
+                            self.field(control).pointer(
+                                mouse.column,
+                                mouse.row,
+                                mouse.modifiers.contains(KeyModifiers::SHIFT),
+                            );
+                            self.selecting = Some(control);
+                            return EventResult::Consumed(None);
+                        }
+                    }
+                    if !inside {
+                        self.focus = None;
+                        self.use_initial_scopes = false;
+                        self.note = None;
+                    }
+                }
+                if inside {
+                    self.hover = target;
+                    return EventResult::Consumed(None);
+                }
+                self.hover = None;
+                return EventResult::Ignored(None);
+            }
+            Event::Paste(value) => {
+                if let Some(control @ (Control::Find | Control::Replace)) = self.focus {
+                    self.field(control).insert(&value.replace("\r\n", "\n"));
+                    self.refresh(cx.editor, control == Control::Find);
+                    return EventResult::Consumed(None);
+                }
+                return EventResult::Ignored(None);
+            }
+            Event::Key(key) => {
+                let ctrl = key.modifiers.contains(KeyModifiers::CONTROL);
+                let alt = key.modifiers.contains(KeyModifiers::ALT);
+                let shift = key.modifiers.contains(KeyModifiers::SHIFT);
+                if key.code == KeyCode::Esc {
+                    let focused = self.focus.is_some();
+                    return match self.close(cx.editor) {
+                        EventResult::Consumed(cb) if !focused => EventResult::Ignored(cb),
+                        result => result,
+                    };
+                }
+                if ctrl && !alt && matches!(key.code, KeyCode::Char('f' | 'h')) {
+                    let replace = key.code == KeyCode::Char('h');
+                    let focus_replace = replace
+                        && (self.focus == Some(Control::Find) || self.single_selection(cx.editor));
+                    if replace {
+                        self.expanded = true;
+                    }
+                    if self.focus.is_none() && (!replace || self.single_selection(cx.editor)) {
+                        self.seed(cx.editor);
+                        self.refresh(cx.editor, true);
+                    }
+                    let target = if focus_replace {
+                        Control::Replace
+                    } else {
+                        Control::Find
+                    };
+                    self.focus = Some(target);
+                    let field = self.field(target);
+                    field.anchor = 0;
+                    field.cursor = field.text.len();
+                    return EventResult::Consumed(None);
+                }
+                if self.focus.is_none() {
+                    return EventResult::Ignored(None);
+                }
+                if alt && !ctrl {
+                    let control = match key.code {
+                        KeyCode::Char('c') => Some(Control::Case),
+                        KeyCode::Char('w') => Some(Control::Word),
+                        KeyCode::Char('r') => Some(Control::Regex),
+                        KeyCode::Char('l') => Some(Control::Scope),
+                        KeyCode::Char('p') => Some(Control::Preserve),
+                        _ => None,
+                    };
+                    if let Some(control) = control {
+                        self.activate(control, cx.editor);
+                        return EventResult::Consumed(None);
+                    }
+                }
+                if key.code == KeyCode::Tab {
+                    self.cycle(shift);
+                    return EventResult::Consumed(None);
+                }
+                if ctrl && alt && key.code == KeyCode::Enter {
+                    self.replace_matches(cx.editor, true);
+                    return EventResult::Consumed(None);
+                }
+                if key.code == KeyCode::Enter && !ctrl && !alt {
+                    match self.focus.unwrap() {
+                        Control::Find => self.navigate(cx.editor, if shift { -1 } else { 1 }),
+                        Control::Replace => self.replace_matches(cx.editor, false),
+                        Control::Close => return self.close(cx.editor),
+                        control => self.activate(control, cx.editor),
+                    }
+                    return EventResult::Consumed(None);
+                }
+                if key.code == KeyCode::Char(' ')
+                    && !ctrl
+                    && !alt
+                    && !matches!(self.focus, Some(Control::Find | Control::Replace))
+                {
+                    let control = self.focus.unwrap();
+                    if control == Control::Close {
+                        return self.close(cx.editor);
+                    }
+                    self.activate(control, cx.editor);
+                    return EventResult::Consumed(None);
+                }
+                if let Some(control @ (Control::Find | Control::Replace)) = self.focus {
+                    if self.field(control).key(*key, cx.editor) {
+                        self.note = None;
+                        self.refresh(cx.editor, control == Control::Find);
+                        return EventResult::Consumed(None);
+                    }
+                }
+                return if ctrl || alt {
+                    EventResult::Ignored(None)
+                } else {
+                    EventResult::Consumed(None)
+                };
+            }
+            _ => {}
+        }
+        EventResult::Ignored(None)
+    }
+    fn render(&mut self, area: Rect, surface: &mut Surface, cx: &mut Context) {
+        self.bind(cx.editor);
+        if cx
+            .editor
+            .document(self.doc)
+            .is_some_and(|d| d.version() != self.version)
+        {
+            self.refresh(cx.editor, false);
+        }
+        let editor = &*cx.editor;
+        let view = editor.tree.get(self.view);
+        let Some(doc) = editor.document(self.doc) else {
+            return;
+        };
+        let inner = view.inner_area(doc).intersection(area);
+        if inner.width < 16 || inner.height < 3 {
+            self.area = Rect::default();
+            self.buttons.clear();
+            return;
+        }
+        let width = editor
+            .devtui
+            .find_widget_width
+            .unwrap_or(DEFAULT_WIDTH)
+            .max(MIN_WIDTH)
+            .min(inner.width);
+        let find_height = self
+            .find
+            .height()
+            .min(
+                inner
+                    .height
+                    .saturating_sub(if self.expanded { 3 } else { 2 }),
+            )
+            .max(1);
+        let replace_height = if self.expanded {
+            self.replace
+                .height()
+                .min(inner.height.saturating_sub(find_height + 2))
+                .max(1)
+        } else {
+            0
+        };
+        self.area = Rect::new(
+            inner.right() - width,
+            inner.y,
+            width,
+            (find_height + replace_height + 2).min(inner.height),
+        );
+        self.buttons.clear();
+        let bg = editor.theme.get("ui.popup");
+        let edge = editor.theme.get("ui.window");
+        surface.clear_with(self.area, bg);
+        let left = self.area.x;
+        let right = self.area.right() - 1;
+        let top = self.area.y;
+        let bottom = self.area.bottom() - 1;
+        surface.set_string(
+            left,
+            top,
+            &format!("┌{}┐", "─".repeat(width.saturating_sub(2) as usize)),
+            edge,
+        );
+        surface.set_string(
+            left,
+            bottom,
+            &format!("└{}┘", "─".repeat(width.saturating_sub(2) as usize)),
+            edge,
+        );
+        for y in top + 1..bottom {
+            surface.set_string(left, y, "│", edge);
+            surface.set_string(right, y, "│", edge);
+        }
+        surface.set_stringn(
+            left + 2,
+            top,
+            if self.expanded {
+                " Find / Replace "
+            } else {
+                " Find "
+            },
+            width.saturating_sub(4) as usize,
+            edge,
+        );
+        let y = top + 1;
+        self.button(
+            Rect::new(left + 1, y, 2, 1),
+            Control::Expand,
+            if self.expanded { "v" } else { ">" },
+            false,
+            true,
+            surface,
+            editor,
+        );
+        // At very small terminal widths use one-cell action icons; keep all
+        // controls inside the editor and preserve at least one editable cell.
+        let compact = width < MIN_WIDTH;
+        let step = if compact { 1 } else { 3 };
+        let outside = 4 * step;
+        let inside = if compact { 3 } else { 9 };
+        let field_left = left + 3;
+        let field_right = right.saturating_sub(outside + 1).max(field_left + 1);
+        let text_right = field_right.saturating_sub(inside + 1).max(field_left + 1);
+        surface.set_string(field_left, y, "[", edge);
+        surface.set_string(field_right, y, "]", edge);
+        self.find.render(
+            Rect::new(
+                field_left + 1,
+                y,
+                text_right.saturating_sub(field_left + 1),
+                find_height,
+            ),
+            surface,
+            editor,
+            self.focus == Some(Control::Find),
+        );
+        let flags = [
+            (
+                Control::Case,
+                if compact { "A" } else { "Aa " },
+                editor.devtui.find_match_case,
+            ),
+            (
+                Control::Word,
+                if compact { "W" } else { "W  " },
+                editor.devtui.find_whole_word,
+            ),
+            (
+                Control::Regex,
+                if compact { "*" } else { ".* " },
+                editor.devtui.find_regex,
+            ),
+        ];
+        for (i, (control, label, active)) in flags.into_iter().enumerate() {
+            self.button(
+                Rect::new(text_right + i as u16 * step, y, step, 1),
+                control,
+                label,
+                active,
+                true,
+                surface,
+                editor,
+            );
+        }
+        let has_hits = !doc.devtui_find_hits.is_empty();
+        let scope = doc.devtui_find_scopes.is_some();
+        let can_scope = scope
+            || (self.use_initial_scopes && !self.initial_scopes.is_empty())
+            || !Self::selections(editor, self.doc, self.view).is_empty();
+        for (i, (control, label, active, enabled)) in [
+            (Control::Previous, "↑", false, has_hits),
+            (Control::Next, "↓", false, has_hits),
+            (Control::Scope, "≡", scope, can_scope),
+            (Control::Close, "×", false, true),
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            self.button(
+                Rect::new(field_right + 1 + i as u16 * step, y, step, 1),
+                control,
+                label,
+                active,
+                enabled,
+                surface,
+                editor,
+            );
+        }
+        if self.expanded && y + find_height < bottom {
+            let ry = y + find_height;
+            surface.set_string(field_left, ry, "[", edge);
+            surface.set_string(field_right, ry, "]", edge);
+            let preserve_width = if compact { 1 } else { 3 };
+            let text_right = field_right
+                .saturating_sub(preserve_width + 1)
+                .max(field_left + 1);
+            self.replace.render(
+                Rect::new(
+                    field_left + 1,
+                    ry,
+                    text_right.saturating_sub(field_left + 1),
+                    replace_height.min(bottom - ry),
+                ),
+                surface,
+                editor,
+                self.focus == Some(Control::Replace),
+            );
+            self.button(
+                Rect::new(text_right, ry, preserve_width, 1),
+                Control::Preserve,
+                if compact { "P" } else { "AB " },
+                editor.devtui.find_preserve_case,
+                true,
+                surface,
+                editor,
+            );
+            self.button(
+                Rect::new(field_right + 1, ry, step, 1),
+                Control::ReplaceOne,
+                "↦",
+                false,
+                has_hits,
+                surface,
+                editor,
+            );
+            self.button(
+                Rect::new(field_right + 1 + step, ry, step, 1),
+                Control::ReplaceAll,
+                "⇉",
+                false,
+                has_hits,
+                surface,
+                editor,
+            );
+        }
+        let selected = doc.selection(self.view).primary();
+        let index = doc
+            .devtui_find_hits
+            .iter()
+            .position(|r| r.start == selected.from() && r.end == selected.to())
+            .map_or(0, |i| i + 1);
+        let count = format!(" {index}/{} matches ", doc.devtui_find_hits.len());
+        let detail = self
+            .error
+            .as_deref()
+            .or(self.note.as_deref())
+            .or(self.hover.or(self.focus).map(Control::tip))
+            .unwrap_or("Drag left edge to resize");
+        let status = format!("{count}{detail}");
+        surface.set_stringn(
+            left + 1,
+            bottom,
+            &status,
+            width.saturating_sub(2) as usize,
+            editor.theme.get(if self.error.is_some() {
+                "error"
+            } else {
+                "ui.text.inactive"
+            }),
+        );
+    }
+    fn cursor(&self, _area: Rect, _editor: &Editor) -> (Option<Position>, CursorKind) {
+        let field = match self.focus {
+            Some(Control::Find) => Some(&self.find),
+            Some(Control::Replace) if self.expanded => Some(&self.replace),
+            _ => None,
+        };
+        if let Some(field) = field {
+            (field.caret, CursorKind::Bar)
+        } else if self.focus.is_some() {
+            (
+                Some(Position::new(self.area.y as usize, self.area.x as usize)),
+                CursorKind::Hidden,
+            )
+        } else {
+            (None, CursorKind::Hidden)
+        }
+    }
+}
