+    /// Composite a line decoration over already rendered backgrounds while
+    /// retaining glyphs, foregrounds, cursor modifiers and diagnostic underlines.
+    pub fn map_line_background(&mut self, visual_line: u16, mut map: impl FnMut(Color) -> Color) {
+        let Some(row) = visual_line.checked_sub(self.offset.row as u16) else { return; };
+        if row >= self.viewport.height { return; }
+        let y = self.viewport.y + row;
+        for x in self.viewport.x..self.viewport.right() {
+            if let Some(cell) = self.surface.get_mut(x, y) { cell.bg = map(cell.bg); }
+        }
+    }
