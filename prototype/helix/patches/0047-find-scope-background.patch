+//! A separate, translucent whole-line Find scope decoration, matching VS Code.
+//! Defaults: editor.findRangeHighlightBackground (#3a3d4166 / #b4b4b44d).
+use super::Decoration;
+use crate::ui::document::{LinePos, TextRenderer};
+use helix_core::Position;
+use helix_view::{graphics::Color, Document, Theme};
+use std::ops::Range;
+
+pub struct FindScope {
+    lines: Vec<Range<usize>>,
+    tint: Tint,
+}
+impl FindScope {
+    pub fn new(doc: &Document, theme: &Theme) -> Option<Self> {
+        let scopes = doc.devtui_find_scopes.as_ref()?;
+        let mut lines: Vec<_> = scopes
+            .iter()
+            .filter(|scope| scope.start < scope.end)
+            .map(|scope| {
+                doc.text().char_to_line(scope.start)..doc.text().char_to_line(scope.end - 1) + 1
+            })
+            .collect();
+        lines.sort_unstable_by_key(|range| range.start);
+        // Several selections may touch the same line. Blend their union once.
+        let mut union: Vec<Range<usize>> = Vec::new();
+        for line in lines {
+            if let Some(previous) = union
+                .last_mut()
+                .filter(|previous| line.start <= previous.end)
+            {
+                previous.end = previous.end.max(line.end);
+            } else {
+                union.push(line);
+            }
+        }
+        if union.is_empty() {
+            return None;
+        }
+        let background = theme
+            .get("ui.background")
+            .bg
+            .and_then(rgb)
+            .unwrap_or([0, 0, 0]);
+        Some(Self {
+            lines: union,
+            tint: Tint::new(background),
+        })
+    }
+}
+impl Decoration for FindScope {
+    fn render_virt_lines(
+        &mut self,
+        renderer: &mut TextRenderer,
+        pos: LinePos,
+        _offset: Position,
+    ) -> Position {
+        let index = self.lines.partition_point(|line| line.end <= pos.doc_line);
+        if self
+            .lines
+            .get(index)
+            .is_some_and(|line| line.contains(&pos.doc_line))
+        {
+            // This hook runs after the text, syntax, match and selection styles
+            // have been rendered. Modify only each cell's background, so the
+            // selected portion has a composed color instead of erasing scope.
+            renderer.map_line_background(pos.visual_line, |background| self.tint.blend(background));
+        }
+        Position::new(0, 0)
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Tint {
+    color: [u8; 3],
+    alpha: u32,
+    fallback: [u8; 3],
+}
+impl Tint {
+    fn new(background: [u8; 3]) -> Self {
+        let luminance = u32::from(background[0]) * 299
+            + u32::from(background[1]) * 587
+            + u32::from(background[2]) * 114;
+        let (color, alpha) = if luminance > 128_000 {
+            ([180, 180, 180], 77)
+        } else {
+            ([58, 61, 65], 102)
+        };
+        Self {
+            color,
+            alpha,
+            fallback: background,
+        }
+    }
+    fn blend(self, background: Color) -> Color {
+        let background = rgb(background).unwrap_or(self.fallback);
+        let channel = |i| {
+            ((u32::from(self.color[i]) * self.alpha
+                + u32::from(background[i]) * (255 - self.alpha)
+                + 127)
+                / 255) as u8
+        };
+        Color::Rgb(channel(0), channel(1), channel(2))
+    }
+}
+
+// Resolve indexed themes as well as RGB themes; Reset falls back to the
+// theme's editor background. Terminal cells do not have an alpha channel.
+fn rgb(color: Color) -> Option<[u8; 3]> {
+    let index = match color {
+        Color::Reset => return None,
+        Color::Rgb(r, g, b) => return Some([r, g, b]),
+        Color::Indexed(index) => index,
+        Color::Black => 0,
+        Color::Red => 1,
+        Color::Green => 2,
+        Color::Yellow => 3,
+        Color::Blue => 4,
+        Color::Magenta => 5,
+        Color::Cyan => 6,
+        Color::Gray => 7,
+        Color::LightGray => 8,
+        Color::LightRed => 9,
+        Color::LightGreen => 10,
+        Color::LightYellow => 11,
+        Color::LightBlue => 12,
+        Color::LightMagenta => 13,
+        Color::LightCyan => 14,
+        Color::White => 15,
+    };
+    const ANSI: [[u8; 3]; 16] = [
+        [0, 0, 0],
+        [128, 0, 0],
+        [0, 128, 0],
+        [128, 128, 0],
+        [0, 0, 128],
+        [128, 0, 128],
+        [0, 128, 128],
+        [192, 192, 192],
+        [128, 128, 128],
+        [255, 0, 0],
+        [0, 255, 0],
+        [255, 255, 0],
+        [0, 0, 255],
+        [255, 0, 255],
+        [0, 255, 255],
+        [255, 255, 255],
+    ];
+    Some(if index < 16 {
+        ANSI[index as usize]
+    } else if index < 232 {
+        let n = index - 16;
+        let component = |level| if level == 0 { 0 } else { 55 + 40 * level };
+        [component(n / 36), component((n / 6) % 6), component(n % 6)]
+    } else {
+        [8 + (index - 232) * 10; 3]
+    })
+}
