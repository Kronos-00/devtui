+    #[test]
+    fn manual_flags_preserve_include_order_and_language_standards() {
+        let fixture = Fixture::new();
+        let properties = fixture.properties(
+            json!({"configurations":[{"name":"Linux","compilerPath":"/tool chain/clang++",
+            "compilerArgs":["--target=x86_64-unknown-linux-gnu"],"includePath":["z","a","z"],
+            "defines":["FEATURE=7","TEXT=\"two words\""],"forcedInclude":["prelude.h"],
+            "cStandard":"c11","cppStandard":"c++20","intelliSenseMode":"linux-clang-x64"}]}),
+        );
+        let (cpp, database) = properties
+            .command(&fixture.0.join("case.cpp"), "cpp")
+            .unwrap();
+        assert!(!database);
+        assert_eq!(cpp.arguments[0], "/tool chain/clang++");
+        let z = cpp
+            .arguments
+            .iter()
+            .position(|arg| arg.ends_with("/z"))
+            .unwrap();
+        let a = cpp
+            .arguments
+            .iter()
+            .position(|arg| arg.ends_with("/a"))
+            .unwrap();
+        assert!(z < a);
+        assert!(cpp.arguments.contains(&"-DFEATURE=7".into()));
+        assert!(cpp.arguments.contains(&"-DTEXT=\"two words\"".into()));
+        assert!(cpp.arguments.contains(&"-std=c++20".into()));
+        assert!(cpp.arguments.contains(&"-m64".into()));
+        assert!(cpp.arguments.contains(&"-include".into()));
+        let (c, _) = properties.command(&fixture.0.join("case.c"), "c").unwrap();
+        assert!(c.arguments.contains(&"-std=c11".into()));
