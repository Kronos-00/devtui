+//! Find/replace semantics reviewed against VS Code's findModel, textModelSearch,
+//! replacePattern and base/common/search (see the public reference manifest).
+use helix_core::regex::{Regex, RegexBuilder};
+use std::ops::Range;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct SearchOptions {
+    pub regex: bool,
+    pub match_case: bool,
+    pub whole_word: bool,
+}
+
+impl SearchOptions {
+    pub fn compile(self, query: &str) -> Result<Regex, helix_core::regex::Error> {
+        let expression = if self.regex {
+            query.replace("\r\n", "\n")
+        } else {
+            helix_core::regex::escape(&query.replace("\r\n", "\n"))
+        };
+        RegexBuilder::new(&expression)
+            .case_insensitive(!self.match_case)
+            .multi_line(true)
+            .crlf(true)
+            .build()
+    }
+}
+
+/// VS Code searches a model with LF line endings, even for a CRLF file.
+/// Keep a sparse map back to the original UTF-8 offsets for editor edits.
+pub struct SearchText<'a> {
+    pub text: std::borrow::Cow<'a, str>,
+    crlf: Vec<usize>,
+}
+impl<'a> SearchText<'a> {
+    pub fn new(text: &'a str) -> Self {
+        let crlf: Vec<_> = text
+            .match_indices("\r\n")
+            .enumerate()
+            .map(|(removed, (index, _))| index - removed)
+            .collect();
+        let text = if crlf.is_empty() {
+            std::borrow::Cow::Borrowed(text)
+        } else {
+            std::borrow::Cow::Owned(text.replace("\r\n", "\n"))
+        };
+        Self { text, crlf }
+    }
+    pub fn original_offset(&self, offset: usize) -> usize {
+        offset + self.crlf.partition_point(|&newline| newline < offset)
+    }
+}
+
+// VS Code's usual word separators, plus line boundaries. In particular,
+// underscore and non-ASCII identifier characters are regular word characters.
+fn separator(ch: char) -> bool {
+    matches!(ch, ' ' | '\t' | '\r' | '\n') || "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?".contains(ch)
+}
+
+pub fn whole_word(text: &str, range: Range<usize>) -> bool {
+    let hit = &text[range.clone()];
+    (range.start == 0
+        || text[..range.start]
+            .chars()
+            .next_back()
+            .is_some_and(separator)
+        || hit.chars().next().is_some_and(separator))
+        && (range.end == text.len()
+            || text[range.end..].chars().next().is_some_and(separator)
+            || hit.chars().next_back().is_some_and(separator))
+}
+
+pub fn in_scope(range: &Range<usize>, scopes: Option<&[Range<usize>]>) -> bool {
+    scopes.is_none_or(|scopes| {
+        scopes
+            .iter()
+            .any(|scope| range.start >= scope.start && range.end <= scope.end)
+    })
+}
+
+#[derive(Clone, Debug)]
+enum Piece {
+    Static(String),
+    Group(usize, Vec<char>),
+}
+
+/// A parsed replacement is reusable across matches. Literal mode bypasses all
+/// replacement syntax; Preserve Case only applies to entirely static patterns,
+/// exactly as in VS Code (capture groups/case operators have their own casing).
+#[derive(Clone, Debug)]
+pub struct Replacement {
+    pieces: Vec<Piece>,
+    dynamic: bool,
+}
+impl Replacement {
+    pub fn parse(value: &str, regex: bool) -> Self {
+        if !regex {
+            return Self {
+                pieces: vec![Piece::Static(value.into())],
+                dynamic: false,
+            };
+        }
+        let chars: Vec<_> = value.chars().collect();
+        let mut pieces = Vec::new();
+        let mut plain = String::new();
+        let mut ops = Vec::new();
+        let mut i = 0;
+        while i < chars.len() {
+            let ch = chars[i];
+            i += 1;
+            if ch == '\\' && i < chars.len() {
+                let next = chars[i];
+                i += 1;
+                match next {
+                    '\\' => plain.push('\\'),
+                    'n' => plain.push('\n'),
+                    't' => plain.push('\t'),
+                    'u' | 'U' | 'l' | 'L' => ops.push(next),
+                    _ => {
+                        plain.push('\\');
+                        plain.push(next);
+                    }
+                }
+            } else if ch == '$' && i < chars.len() {
+                let next = chars[i];
+                i += 1;
+                if next == '$' {
+                    plain.push('$');
+                    continue;
+                }
+                let index = if next == '&' || next == '0' {
+                    Some(0)
+                } else if ('1'..='9').contains(&next) {
+                    let mut n = next as usize - '0' as usize;
+                    if i < chars.len() && chars[i].is_ascii_digit() {
+                        n = n * 10 + chars[i] as usize - '0' as usize;
+                        i += 1;
+                    }
+                    Some(n)
+                } else {
+                    None
+                };
+                if let Some(index) = index {
+                    if !plain.is_empty() {
+                        pieces.push(Piece::Static(std::mem::take(&mut plain)));
+                    }
+                    pieces.push(Piece::Group(index, std::mem::take(&mut ops)));
+                } else {
+                    plain.push('$');
+                    plain.push(next);
+                }
+            } else {
+                plain.push(ch);
+            }
+        }
+        if !plain.is_empty() {
+            pieces.push(Piece::Static(plain));
+        }
+        let dynamic = pieces.iter().any(|p| matches!(p, Piece::Group(..)));
+        Self { pieces, dynamic }
+    }
+
+    pub fn expand(&self, groups: &[Option<&str>], preserve: bool) -> String {
+        let mut result = String::new();
+        for piece in &self.pieces {
+            match piece {
+                Piece::Static(value) => result.push_str(value),
+                Piece::Group(index, ops) => {
+                    let mut n = *index;
+                    let mut suffix = String::new();
+                    let value = loop {
+                        if n < groups.len() && (n > 0 || *index == 0) {
+                            break format!("{}{suffix}", groups[n].unwrap_or(""));
+                        }
+                        if n == 0 {
+                            break format!("${suffix}");
+                        }
+                        suffix.insert(0, char::from(b'0' + (n % 10) as u8));
+                        n /= 10;
+                    };
+                    result.push_str(&case_ops(&value, ops));
+                }
+            }
+        }
+        if preserve && !self.dynamic {
+            preserve_case(groups.first().copied().flatten().unwrap_or(""), &result)
+        } else {
+            result
+        }
+    }
+}
+
+// Upstream applies case operators to UTF-16 code units. Preserve this detail
+// for astral text, while retaining Unicode expansion (eg. uppercase sharp s).
+fn case_unit(unit: u16, upper: bool) -> Vec<u16> {
+    match char::from_u32(unit as u32) {
+        Some(ch) => if upper {
+            ch.to_uppercase().collect::<String>()
+        } else {
+            ch.to_lowercase().collect::<String>()
+        }
+        .encode_utf16()
+        .collect(),
+        None => vec![unit],
+    }
+}
+fn case_ops(value: &str, ops: &[char]) -> String {
+    let mut result = Vec::new();
+    let mut op = 0;
+    for unit in value.encode_utf16() {
+        if let Some(&kind) = ops.get(op) {
+            result.extend(case_unit(unit, matches!(kind, 'u' | 'U')));
+            if matches!(kind, 'u' | 'l') {
+                op += 1;
+            }
+        } else {
+            result.push(unit);
+        }
+    }
+    String::from_utf16_lossy(&result)
+}
+fn first_case(value: &str, upper: bool) -> String {
+    let mut units = value.encode_utf16();
+    let Some(first) = units.next() else {
+        return String::new();
+    };
+    let mut result = case_unit(first, upper);
+    result.extend(units);
+    String::from_utf16_lossy(&result)
+}
+fn preserve_case(original: &str, value: &str) -> String {
+    if original.is_empty() {
+        return value.into();
+    }
+    let valid = |sep| {
+        original.contains(sep)
+            && value.contains(sep)
+            && original.split(sep).count() == value.split(sep).count()
+    };
+    let hyphen = valid('-');
+    let underscore = valid('_');
+    if hyphen != underscore {
+        let sep = if hyphen { '-' } else { '_' };
+        return original
+            .split(sep)
+            .zip(value.split(sep))
+            .map(|(a, b)| preserve_case(a, b))
+            .collect::<Vec<_>>()
+            .join(&sep.to_string());
+    }
+    if original.to_uppercase() == original {
+        value.to_uppercase()
+    } else if original.to_lowercase() == original {
+        value.to_lowercase()
+    } else {
+        let first = original.encode_utf16().next().unwrap();
+        if case_unit(first, false) != vec![first] {
+            first_case(value, true)
+        } else if case_unit(first, true) != vec![first] {
+            first_case(value, false)
+        } else {
+            value.into()
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn numeric_groups_dollars_and_missing_groups() {
+        let groups = [Some("ab"), Some("a"), Some("b"), None];
+        assert_eq!(
+            Replacement::parse("$2$1 $$ $& $0 $12 $99 $3 ${1} $<x>", true).expand(&groups, false),
+            "ba $ ab ab a2 $99  ${1} $<x>"
+        );
+        assert_eq!(
+            Replacement::parse("$00-$01-$123", true).expand(&groups, false),
+            "ab0-ab1-a23"
+        );
+        assert_eq!(
+            Replacement::parse("$1\\n$$", false).expand(&groups, false),
+            "$1\\n$$"
+        );
+    }
+    #[test]
+    fn escapes_and_case_operators() {
+        let groups = [Some("AbCd"), Some("AbCd")];
+        assert_eq!(
+            Replacement::parse(r"\u\u\l\L$1|\l\U$1|\n\t\\|\q|\$1", true).expand(&groups, false),
+            "ABcd|aBCD|\n\t\\|\\q|\\$1"
+        );
+        assert_eq!(
+            Replacement::parse(r"\u$1", true).expand(&[Some("😀a"), Some("😀a")], false),
+            "😀a"
+        );
+    }
+    #[test]
+    fn preserved_static_and_dynamic_case() {
+        for (a, b, want) in [
+            ("FOO", "bar", "BAR"),
+            ("foo", "BAR", "bar"),
+            ("Foo", "bar", "Bar"),
+            ("fOo", "BAR", "bAR"),
+            ("foo-BAR", "new-text", "new-TEXT"),
+            ("Foo_bar", "new_WORD", "New_word"),
+        ] {
+            assert_eq!(Replacement::parse(b, false).expand(&[Some(a)], true), want);
+        }
+        assert_eq!(
+            Replacement::parse("x$1", true).expand(&[Some("ABC"), Some("ABC")], true),
+            "xABC"
+        );
+    }
+    #[test]
+    fn word_separators_include_match_edges_not_unicode_boundaries() {
+        assert!(whole_word("a.b", 1..2));
+        assert!(whole_word("中 foo-bar 文", 4..7));
+        assert!(!whole_word("中foo文", 3..6));
+        assert!(!whole_word("cat_catalog", 0..3));
+    }
+    #[test]
+    fn crlf_search_offsets_and_capture_text() {
+        let original = "中\r\nfoo\r\nbar";
+        let normalized = SearchText::new(original);
+        assert_eq!(normalized.text, "中\nfoo\nbar");
+        let pattern = SearchOptions::default().compile("中\nfoo").unwrap();
+        let hit = pattern.find(&normalized.text).unwrap();
+        assert_eq!(
+            &original
+                [normalized.original_offset(hit.start())..normalized.original_offset(hit.end())],
+            "中\r\nfoo"
+        );
+        let newline = SearchOptions::default().compile("\n").unwrap();
+        for hit in newline.find_iter(&normalized.text) {
+            assert_eq!(
+                &original[normalized.original_offset(hit.start())
+                    ..normalized.original_offset(hit.end())],
+                "\r\n"
+            );
+        }
+    }
+
