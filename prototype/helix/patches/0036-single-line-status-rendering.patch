 use tui::{buffer::Buffer as Surface, text::Span};
 
+/// Status messages occupy one terminal row. Raw command/LSP output must not
+/// send control characters to the terminal and invalidate the rendered geometry.
+fn single_line_status(message: &str) -> Cow<'_, str> {
+    let unsafe_char = |ch: char| ch.is_control() || matches!(ch, '\u{2028}' | '\u{2029}');
+    if !message.chars().any(unsafe_char) {
+        return Cow::Borrowed(message);
+    }
+    Cow::Owned(
+        message
+            .chars()
+            .map(|ch| if unsafe_char(ch) { ' ' } else { ch })
+            .collect(),
+    )
+}
