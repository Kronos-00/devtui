+                    }
                     break;
                 }
+                // Close only documents belonging to a successfully deleted entry.
+                for id in affected { let _ = editor.close_document(id, true); }
+                editor.devtui.explorer_clipboard.retain(|entry| entry != path && !entry.starts_with(path));
             }
-        },
-    )
+        })
 }
 
