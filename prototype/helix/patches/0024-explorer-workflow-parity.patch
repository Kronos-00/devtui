+pub fn explorer_delete_select(editor: &Editor, paths: Vec<PathBuf>, permanent: bool) -> Select<DeleteChoice> {
+    let dirty = editor.documents().filter(|doc| doc.is_modified() && doc.path().is_some_and(|name| paths.iter().any(|p| name == p || (p.is_dir() && name.starts_with(p))))).count();
+    let description = if paths.len() == 1 {
+        paths[0].file_name().unwrap_or_default().to_string_lossy().into_owned()
+    } else { format!("{} selected items", paths.len()) };
+    let warning = if dirty > 0 { format!(" ({dirty} file(s) have unsaved changes which will be lost)") } else { String::new() };
+    let title = if permanent {
+        format!("Trash unavailable. Permanently delete {description}?{warning}")
+    } else { format!("Move {description} to Trash?{warning}") };
+    Select::new(title,
+        [if permanent { DeleteChoice::Delete } else { DeleteChoice::Trash }, DeleteChoice::Cancel],
+        (), move |editor, choice, event| {
+            if event != PromptEvent::Validate || matches!(choice, DeleteChoice::Cancel) { return; }
+            for (index, path) in paths.iter().enumerate() {
+                let affected: Vec<_> = editor.documents().filter(|doc| doc.path().is_some_and(|name| name == path || (path.is_dir() && name.starts_with(path)))).map(|doc| doc.id()).collect();
+                if let Err(err) = editor.devtui_delete_path(path, true, !permanent) {
