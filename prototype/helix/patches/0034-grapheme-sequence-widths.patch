+
+#[cfg(test)]
+mod devtui_width_tests {
+    use super::grapheme_width;
+
+    #[test]
+    fn complex_emoji_occupy_one_wide_grapheme() {
+        for text in ["😀", "👩‍💻", "👍🏽", "🇨🇳", "👨‍👩‍👧‍👦", "🤦🏼‍♂️"] {
+            assert_eq!(grapheme_width(text), 2, "{text}");
+        }
+        for text in ["中", "日", "한", "，"] {
+            assert_eq!(grapheme_width(text), 2, "{text}");
+        }
+        for text in ["a", "é", "e\u{301}", "o\u{308}"] {
+            assert_eq!(grapheme_width(text), 1, "{text}");
+        }
+    }
+}
