#!/usr/bin/env -S python3 -I -S
"""Start the terminal workspace without running another shell startup pass."""
import argparse
import json
import os
import shutil
import sys
from pathlib import Path

parser = argparse.ArgumentParser(description="Start the Helix edition with the inherited environment.")
parser.add_argument("directory", nargs="?", default=os.getcwd(), help="project directory")
parser.add_argument("--version", action="store_true", help="print the installed build fingerprint")
parser.add_argument("--health", nargs="?", const="", metavar="LANGUAGE", help="check the installed editor/tool setup")
args = parser.parse_args()
home = Path(os.environ.get("HOME", str(Path.home())))
prefix = home / ".local/opt/devtui/helix-prototype"
if args.version:
    try:
        metadata = json.loads((prefix / "build-info.json").read_text())
        print("devtui Helix " + metadata.get("patched_tree", "unknown"))
        print("upstream " + metadata.get("upstream", "unknown"))
        print("binary " + metadata.get("binary_sha256", "not recorded"))
        workspace_info = prefix / "workspace-build-info.json"
        if workspace_info.is_file():
            workspace = json.loads(workspace_info.read_text())
            print("workspace " + workspace.get("binary_sha256", "not recorded"))
            print("shortcuts " + workspace.get("shortcuts_plugin_sha256", "not recorded"))
    except (OSError, ValueError) as error:
        print(f"Build fingerprint unavailable: {error}", file=sys.stderr)
        raise SystemExit(1)
    raise SystemExit(0)
if args.health is not None:
    env = os.environ.copy()
    env["HELIX_RUNTIME"] = str(prefix / "runtime")
    env["XDG_CONFIG_HOME"] = str(home / ".config/devtui-helix")
    env["PATH"] = str(home / ".local/opt/devtui/helix-tools/bin") + os.pathsep + env.get("PATH", "")
    command = [str(prefix / "bin/hx"), "--health"]
    if args.health:
        command.append(args.health)
    os.execvpe(command[0], command, env)
try:
    os.chdir(args.directory)
except OSError as error:
    parser.error(str(error))

# Only private IPC bookkeeping is introduced; compiler, SDK, locale, PATH and
# shell-startup variables remain exactly as exported by the calling process.
identity = f"{os.getuid()}-{os.getpid()}"
os.environ["DEVTUI_HELIX_EDITOR_PANE_FILE"] = f"/tmp/devtui-helix-editor-{identity}.pane"
os.environ["DEVTUI_HELIX_SOCKET"] = f"/tmp/devtui-helix-{identity}.sock"
try:
    columns = int(os.environ.get("DEVTUI_COLUMNS", "0"))
except ValueError:
    columns = 0
if columns < 20:
    columns = shutil.get_terminal_size(fallback=(120, 30)).columns
home = Path(os.environ.get("HOME", str(Path.home())))
layout = home / ".config/zellij/layouts" / ("dev-helix-wide.kdl" if columns >= 240 else "dev-helix.kdl")
workspace_binary = prefix / "bin/zellij"
command = [str(workspace_binary) if workspace_binary.is_file() else "zellij"]
workspace_assets = prefix / "share/zellij"
if workspace_binary.is_file() and workspace_assets.is_dir():
    command += ["--data-dir", str(workspace_assets)]
command += ["--config", str(home / ".config/devtui-helix/zellij.kdl"), "--layout", str(layout)]
try:
    os.execvp(command[0], command)
except OSError as error:
    print(f"Cannot start Zellij: {error}", file=sys.stderr)
    raise SystemExit(127)
