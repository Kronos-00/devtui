#!/usr/bin/env bash
set -e
ROOT="${1:-$PWD}"
cd "$ROOT"
export DEVTUI_HELIX_EDITOR_PANE_FILE="/tmp/devtui-helix-editor-${UID}-$$.pane"
export DEVTUI_HELIX_SOCKET="/tmp/devtui-helix-${UID}-$$.sock"
rm -f "$DEVTUI_HELIX_EDITOR_PANE_FILE" "$DEVTUI_HELIX_SOCKET"
exec zellij --config "$HOME/.config/devtui-helix/zellij.kdl" --layout "$HOME/.config/zellij/layouts/dev-helix.kdl"
