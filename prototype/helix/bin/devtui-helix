#!/usr/bin/env bash
set -e
if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  echo 'Usage: devtui-helix [project-directory]'
  echo 'Starts the Helix edition without changing your shell or SDK environment.'
  exit 0
fi
ROOT="${1:-$PWD}"
cd "$ROOT"
export DEVTUI_HELIX_EDITOR_PANE_FILE="/tmp/devtui-helix-editor-${UID}-$$.pane"
export DEVTUI_HELIX_SOCKET="/tmp/devtui-helix-${UID}-$$.sock"
rm -f "$DEVTUI_HELIX_EDITOR_PANE_FILE" "$DEVTUI_HELIX_SOCKET"

cols="${DEVTUI_COLUMNS:-}"
if ! [[ "$cols" =~ ^[0-9]+$ ]] || [ "$cols" -lt 20 ]; then
  cols="$(stty size 2>/dev/null | awk '{print $2}')"
fi
if ! [[ "$cols" =~ ^[0-9]+$ ]] || [ "$cols" -lt 20 ]; then
  cols="$(tput cols 2>/dev/null || true)"
fi
if ! [[ "$cols" =~ ^[0-9]+$ ]] || [ "$cols" -lt 20 ]; then
  cols=120
fi

layout="$HOME/.config/zellij/layouts/dev-helix.kdl"
if [ "$cols" -ge 240 ]; then
  layout="$HOME/.config/zellij/layouts/dev-helix-wide.kdl"
fi

exec zellij --config "$HOME/.config/devtui-helix/zellij.kdl" --layout "$layout"
