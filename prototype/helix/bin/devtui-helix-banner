#!/usr/bin/env bash
set -e
old_stty="$(stty -g 2>/dev/null || true)"
cleanup() { [ -n "$old_stty" ] && stty "$old_stty" 2>/dev/null || true; printf '\033[?25h'; }
trap cleanup EXIT
trap 'exit 0' INT TERM
stty -echo -icanon min 0 time 0 2>/dev/null || true
printf '\033[?25l\033[2J\033[H'
cols="$(stty size 2>/dev/null | awk '{print $2}')"
if [[ "$cols" =~ ^[0-9]+$ ]] && [ "$cols" -ge 240 ]; then
  printf '%s\n' '[devtui-helix] C-P open | C-S-F search | C-H replace | C-S-E Explorer | F12 definition | S-F12 refs | F5/F10/F11 debug'
  printf '%s'   '[mouse] middle-drag column edit | Explorer/context menus | Ctrl-q quit | Ctrl-o d detach | Alt-click terminal paths'
else
  printf '%s\n' '[devtui-helix] VS Code-style terminal IDE on Helix'
  printf '%s\n' '[NAV] C-P:open | C-S-F:search | C-H:replace | C-S-P:commands | C-S-E:Explorer | F12:def | S-F12:refs'
  printf '%s\n' '[EDIT] middle-drag:column edit | C-D:next occurrence | C-S-L:all occurrences | C-S-S:Save As'
  printf '%s'   '[SESSION] Ctrl-q:quit | Ctrl-o d:detach | Alt-click terminal path opens in the running editor'
fi
while :; do
  if [ -t 0 ]; then
    IFS= read -rsn1 -t 1 _ || true
  else
    sleep 1
  fi
done
