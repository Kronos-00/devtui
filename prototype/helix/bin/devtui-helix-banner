#!/usr/bin/env bash
set -e
old_stty="$(stty -g 2>/dev/null || true)"
cleanup() { [ -n "$old_stty" ] && stty "$old_stty" 2>/dev/null || true; printf '\033[?25h'; }
trap cleanup EXIT INT TERM
stty -echo -icanon min 0 time 0 2>/dev/null || true
printf '\033[?25l\033[2J\033[H'
printf '%s\n' '[HELIX PROTOTYPE] middle-drag: multi-selection | i: realtime insert | arrows: move all selections'
printf '%s\n' '[NAV] C-P:open | C-S-F:search | C-S-P:commands | C-S-E:file explorer | F12:def | S-F12:refs'
printf '%s\n' '[SESSION] Ctrl-q:quit devtui | Ctrl-o d:detach | prototype gaps: persistent tree / preview-pinned / editor IPC'
printf '%s'   '[COMPARE] normal devtui remains installed separately; run devtui-helix only for evaluation'
while IFS= read -rsn1 -t 0.10 _; do :; done
