[
  {
    "name": "reorder",
    "pattern": "$2:$1",
    "groups": [
      "AbCd-xy",
      "AbCd",
      "xy",
      null
    ],
    "regex": true,
    "preserve": false,
    "expected": "xy:AbCd"
  },
  {
    "name": "whole",
    "pattern": "$&/$0",
    "groups": [
      "AbCd-xy",
      "AbCd",
      "xy",
      null
    ],
    "regex": true,
    "preserve": false,
    "expected": "AbCd-xy/AbCd-xy"
  },
  {
    "name": "dollars",
    "pattern": "$$/$/$$$1",
    "groups": [
      "AbCd-xy",
      "AbCd",
      "xy",
      null
    ],
    "regex": true,
    "preserve": false,
    "expected": "$/$/$AbCd"
  },
  {
    "name": "two_digits",
    "pattern": "$12/$99/$10",
    "groups": [
      "AbCd-xy",
      "AbCd",
      "xy",
      null
    ],
    "regex": true,
    "preserve": false,
    "expected": "AbCd2/$99/AbCd0"
  },
  {
    "name": "missing",
    "pattern": "$3/$9",
    "groups": [
      "AbCd-xy",
      "AbCd",
      "xy",
      null
    ],
    "regex": true,
    "preserve": false,
    "expected": "/$9"
  },
  {
